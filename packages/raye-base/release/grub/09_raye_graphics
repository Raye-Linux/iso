#!/bin/sh
# The graphics ladder: what the kernel is told about the graphics card,
# chosen again at every start from what happened at the last ones.
#
#   level 0 (default)  nothing: the graphics driver as it comes
#   level 1            amdgpu.dc=0 plymouth.enable=0: the older display
#                      path of AMD cards, for cards (an RX 550 was the first
#                      report) that leave the screen black with the newer
#                      one, and no boot screen, so nothing sits between the
#                      firmware picture and the sign-in screen
#   level 2            nomodeset: the picture the firmware set up, like the
#                      "Safe graphics" entry of the install USB
#
# Each start of Raye counts one try in the boot menu's state (grubenv); reaching the
# desktop (raye-graphics-ok) clears it. A try left from the last start also
# shows the boot menu, hidden otherwise (50-raye.cfg). After two starts in a row where
# nobody reached the desktop, the next start goes one level down, so a black
# screen costs two restarts, never a reinstall. A level that reached the
# desktop is kept. The words land on the normal entries through $raye_gfx,
# written into the kernel command line by 50-raye.cfg.
#
# GRUB can only write its state on a plain /boot (ext4, FAT): elsewhere
# (btrfs, LVM, a RAID) nothing is printed here and every start is level 0,
# as before.
set -e
fs=$(${grub_probe:-grub-probe} --target=fs "${RAYE_BOOT_DIR:-/boot}" 2>/dev/null || true)
case $fs in
ext2|ext3|ext4|fat) ;;
*) exit 0 ;;
esac
cat <<'GRUB'
# the graphics ladder (09_raye_graphics)
# the last start never reached the desktop: the hidden menu shows this time
if [ "${raye_gfx_fails}" = 1 ]; then
  set timeout_style=menu
  if [ "${timeout}" = 0 ]; then set timeout=3; fi
fi
if [ "${raye_gfx_fails}" = 2 ]; then
  set timeout_style=menu
  if [ "${timeout}" = 0 ]; then set timeout=3; fi
fi
if [ "${raye_gfx_fails}" = 2 ]; then
  if [ "${raye_gfx_level}" = 1 ]; then set raye_gfx_level=2
  elif [ "${raye_gfx_level}" != 2 ]; then set raye_gfx_level=1
  fi
  set raye_gfx_fails=0
  if [ "${have_grubenv}" = true ]; then save_env raye_gfx_level raye_gfx_fails; fi
fi
if [ "${raye_gfx_level}" = 2 ]; then set raye_gfx=nomodeset
elif [ "${raye_gfx_level}" = 1 ]; then set raye_gfx="amdgpu.dc=0 plymouth.enable=0"
else set raye_gfx=
fi
# The try is counted when a Raye entry starts, not when the menu is read:
# starting Windows or the firmware settings twice took the boot screen
# away from Raye. Every entry of 10_linux begins with recordfail; this is
# the one of 00_header with the count added.
function recordfail {
  set recordfail=1
  if [ -n "${have_grubenv}" ]; then if [ -z "${boot_once}" ]; then save_env recordfail; fi; fi
  if [ "${raye_gfx_fails}" = 1 ]; then set raye_gfx_fails=2; else set raye_gfx_fails=1; fi
  if [ "${have_grubenv}" = true ]; then save_env raye_gfx_fails; fi
}
GRUB
