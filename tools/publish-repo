#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Builds the signed apt tree of Raye's own packages.

    publish-repo                 from the last image build, into $STAGE/apt
    publish-repo --dry-run       say what would change, write nothing
    publish-repo --debs DIR --out DIR [--no-sign]
    publish-repo --sources DIR   also publish the source packages (.dsc) in DIR
    publish-repo --check DIR     may this tree go out? (no image, no secret, signed)
    publish-repo --suite resolute-beta --debs DIR
                                 publish one Raye Insider channel (see below)

The tree (dists/resolute, pool/main) is the same for every mirror:
publish-r2 and publish-github only copy it. The folder it writes is also
the published state. A package whose version is already in it keeps its
published file when its contents did not change; when they did, the
build stops, because installed systems would never see the change:
raise the version in its debian/changelog.

Nothing but packages goes in: before the new tree replaces the old one
it is audited (raye_publish.audit_tree) -- no image under any name, no
secret key material, every file under GitHub's limits, and a Release
signed by the shipped keyring. A refused tree is not published.

Every folder also gets an index.html (raye_pages), written after the
Release is signed: a visitor browses the tree, apt never reads them.

One tree holds every update channel, one suite each: Stable is SUITE
(resolute), Public Beta, Beta and Dev are SUITE-public-beta, SUITE-beta and
SUITE-dev (Raye Update's raye-insider.sources names them). A publish writes
one suite and carries the others over as they are -- their signed indexes
and every file those name -- so publishing Stable never takes a channel
away, nor a channel Stable. Each suite is given its full set of .debs.

Index files are also kept under by-hash/ for two weeks, so a client that
read an older InRelease from a cache still finds the files it names.

A version that leaves the index keeps its .deb in the pool for GRACE_HOURS
(out of every index), so a PC that read the lists just before a publish
still finishes its download; Raye Update then reads the lists again and
takes the newest. The oldest of these go first if the tree would pass
GRACE_BUDGET (GitHub Pages stays under 1 GB). A file's time is the time it
left the index.
"""
from __future__ import annotations

import argparse
import gzip
import io
import lzma
import os
import pathlib
import shutil
import subprocess
import sys
import tarfile
import time

sys.dont_write_bytecode = True  # no __pycache__ in the repo
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import raye_pages  # noqa: E402
import raye_publish as rp  # noqa: E402

BY_HASH_DAYS = 14
GRACE_HOURS = 72
# what the whole tree may weigh with the old versions in: under GitHub's
# 1 GB for a Pages site, with room for the folder pages
GRACE_BUDGET = rp.TREE_LIMIT - 100 * 1000 * 1000
# SHA256 only: apt fetches by-hash files under the strongest hash it sees
FTPARCHIVE = ["-o", "APT::FTPArchive::MD5=false", "-o", "APT::FTPArchive::SHA1=false",
              "-o", "APT::FTPArchive::SHA512=false"]


def control_of(deb):
    """(fields, control text, md5sums text) of a .deb."""
    tar = subprocess.run(["dpkg-deb", "--ctrl-tarfile", str(deb)], capture_output=True)
    if tar.returncode:
        raise rp.PublishError(f"{deb}: not a package ({tar.stderr.decode().strip()})")
    files = {}
    with tarfile.open(fileobj=io.BytesIO(tar.stdout)) as t:
        for m in t.getmembers():
            name = m.name.lstrip("./")
            if name in ("control", "md5sums") and m.isfile():
                files[name] = t.extractfile(m).read().decode()
    fields = parse_paragraph(files.get("control", ""))
    for key in ("Package", "Version", "Architecture"):
        if key not in fields:
            raise rp.PublishError(f"{deb}: no {key} in its control file")
    return fields, files["control"], files.get("md5sums", "")


def parse_paragraph(text):
    fields, key = {}, None
    for line in text.splitlines():
        if line[:1] in (" ", "\t") and key:
            fields[key] += "\n" + line
        elif ":" in line:
            key, _, value = line.partition(":")
            fields[key] = value.strip()
    return fields


def parse_packages(text):
    return [parse_paragraph(p) for p in text.split("\n\n") if p.strip()]


def pool_dir(fields, component):
    source = fields.get("Source", fields["Package"]).split()[0]
    prefix = source[:4] if source.startswith("lib") else source[0]
    return f"pool/{component}/{prefix}/{source}"


def published(tree, conf):
    """{(package, version, arch): Filename} of the tree as it is now."""
    found = {}
    for arch in conf["ARCHES"].split():
        index = tree / "dists" / conf["SUITE"] / conf["COMPONENT"] / f"binary-{arch}" / "Packages"
        if index.is_file():
            for p in parse_packages(index.read_text()):
                found[(p["Package"], p["Version"], p["Architecture"])] = p["Filename"]
    return found


def plan(debs, tree, conf):
    """[(file to put in the tree, its path in the tree, note)], or PublishError."""
    old = published(tree, conf)
    chosen, errors = {}, []
    for deb in debs:
        fields, control, md5sums = control_of(deb)
        key = (fields["Package"], fields["Version"], fields["Architecture"])
        if key[2] not in conf["ARCHES"].split() + ["all"]:
            errors.append(f"{deb.name}: architecture {key[2]} is not published")
            continue
        if key in chosen:
            if chosen[key][3] != (control, md5sums):
                errors.append(f"{key[0]} {key[1]} is given twice with different contents")
            continue
        rel = f"{pool_dir(fields, conf['COMPONENT'])}/{deb.name}"
        note = "new"
        kept = tree / rel
        if key not in old and kept.is_file() and control_of(kept)[1:] != (control, md5sums):
            # an old version still kept for downloads in progress
            errors.append(f"{key[0]} {key[1]} was published with other contents "
                          "(its file is still downloadable): raise its version (debian/changelog)")
            continue
        if key in old:
            before = tree / old[key]
            if not before.is_file():
                errors.append(f"{key[0]} {key[1]}: {old[key]} is listed but missing")
                continue
            if control_of(before)[1:] != (control, md5sums):
                errors.append(f"{key[0]} {key[1]} is already published with other contents: "
                              "raise its version (debian/changelog)")
                continue
            deb, rel, note = before, old[key], "unchanged"
        chosen[key] = (deb, rel, note, (control, md5sums))
    if errors:
        raise rp.PublishError("\n".join(errors))
    gone = sorted(f"{k[0]} {k[1]}" for k in old if not any(c[:2] == k[:2] for c in chosen))
    return [v[:3] for _, v in sorted(chosen.items())], gone


def source_files(dsc):
    """(Source, Version, [file names]) of a .dsc, or PublishError."""
    text = pathlib.Path(dsc).read_text()
    if text.startswith("-----BEGIN PGP SIGNED MESSAGE-----"):
        text = text.split("\n\n", 1)[1].split("\n-----BEGIN PGP SIGNATURE-----", 1)[0]
    fields = parse_paragraph(text)
    for key in ("Source", "Version", "Checksums-Sha256"):
        if key not in fields:
            raise rp.PublishError(f"{dsc}: no {key}")
    names, folder = [], pathlib.Path(dsc).parent
    for line in fields["Checksums-Sha256"].splitlines():
        parts = line.split()
        if len(parts) != 3:
            continue
        digest, _, name = parts
        if pathlib.Path(name).name != name:
            raise rp.PublishError(f"{dsc}: {name} is not a plain file name")
        if not (folder / name).is_file():
            raise rp.PublishError(f"{dsc}: {name} is missing beside it")
        if rp.sha256(folder / name) != digest:
            raise rp.PublishError(f"{dsc}: {name} does not have the checksum the .dsc names")
        names.append(name)
    return fields["Source"], fields["Version"], names


def plan_sources(dscs, conf):
    """[(file, its path in the tree)] for the source packages."""
    out, seen = [], {}
    for dsc in dscs:
        source, version, names = source_files(dsc)
        if (source, version) in seen:
            raise rp.PublishError(f"source {source} {version} is given twice")
        seen[(source, version)] = dsc
        prefix = source[:4] if source.startswith("lib") else source[0]
        base = f"pool/{conf['COMPONENT']}/{prefix}/{source}"
        for f in [dsc.name, *names]:
            out.append((dsc.parent / f, f"{base}/{f}"))
    return out


CHANNELS = ("", "-public-beta", "-beta", "-dev")


def channel_suites(conf):
    """The suites of the update channels, Stable first."""
    base = conf["SUITE"]
    for ending in CHANNELS[1:]:
        if base.endswith(ending):
            base = base[:-len(ending)]
    return [base + ending for ending in CHANNELS]


def with_suite(conf, suite):
    """conf for publishing `suite`, one of channel_suites(conf)."""
    if suite not in channel_suites(conf):
        raise rp.PublishError(f"unknown suite {suite}: one of {', '.join(channel_suites(conf))}")
    return dict(conf, SUITE=suite)


def carry_other_suites(new, out, conf):
    """Copies the other channels' suites of the old tree into the new one,
    as they are, with the files their indexes name; returns those files."""
    carried = set()
    if not (out / "dists").is_dir():
        return carried
    for suite in channel_suites(conf):
        if suite == conf["SUITE"] or not (out / "dists" / suite).is_dir():
            continue
        shutil.copytree(out / "dists" / suite, new / "dists" / suite)
        for rel in published(out, dict(conf, SUITE=suite)).values():
            src, dest = out / rel, new / rel
            if not src.is_file():
                raise rp.PublishError(f"{suite} names {rel}, which is missing")
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dest)
                os.chmod(dest, 0o644)
            carried.add(rel)
    return carried


def write_indexes(new, conf):
    suite_dir = new / "dists" / conf["SUITE"]
    for arch in conf["ARCHES"].split():
        bdir = suite_dir / conf["COMPONENT"] / f"binary-{arch}"
        bdir.mkdir(parents=True)
        out = subprocess.run(["apt-ftparchive", *FTPARCHIVE, "--arch", arch,
                              "packages", f"pool/{conf['COMPONENT']}"],
                             cwd=new, capture_output=True, text=True, check=True).stdout
        data = out.encode()
        (bdir / "Packages").write_bytes(data)
        # mtime 0 in the gzip header: the same packages give the same file
        with gzip.GzipFile(bdir / "Packages.gz", "wb", mtime=0) as f:
            f.write(data)
        (bdir / "Packages.xz").write_bytes(lzma.compress(data))
        (bdir / "Release").write_text(
            f"Archive: {conf['SUITE']}\nOrigin: Raye\nLabel: Raye\n"
            f"Component: {conf['COMPONENT']}\nArchitecture: {arch}\n")
    if any(new.glob(f"pool/{conf['COMPONENT']}/*/*/*.dsc")):
        sdir = suite_dir / conf["COMPONENT"] / "source"
        sdir.mkdir(parents=True)
        out = subprocess.run(["apt-ftparchive", *FTPARCHIVE, "sources", f"pool/{conf['COMPONENT']}"],
                             cwd=new, capture_output=True, text=True, check=True).stdout
        data = out.encode()
        (sdir / "Sources").write_bytes(data)
        with gzip.GzipFile(sdir / "Sources.gz", "wb", mtime=0) as f:
            f.write(data)
        (sdir / "Sources.xz").write_bytes(lzma.compress(data))
        (sdir / "Release").write_text(
            f"Archive: {conf['SUITE']}\nOrigin: Raye\nLabel: Raye\n"
            f"Component: {conf['COMPONENT']}\nArchitecture: source\n")
    release = subprocess.run(
        ["apt-ftparchive", *FTPARCHIVE,
         "-o", "APT::FTPArchive::Release::Origin=Raye",
         "-o", "APT::FTPArchive::Release::Label=Raye",
         "-o", f"APT::FTPArchive::Release::Suite={conf['SUITE']}",
         "-o", f"APT::FTPArchive::Release::Codename={conf['SUITE']}",
         "-o", f"APT::FTPArchive::Release::Version={conf['RELEASE']}",
         "-o", f"APT::FTPArchive::Release::Architectures={conf['ARCHES']}",
         "-o", f"APT::FTPArchive::Release::Components={conf['COMPONENT']}",
         "-o", "APT::FTPArchive::Release::Description=Raye Linux packages",
         "-o", "APT::FTPArchive::Release::Acquire-By-Hash=yes",
         "release", "."],
        cwd=suite_dir, capture_output=True, text=True, check=True).stdout
    (suite_dir / "Release").write_text(release)
    return suite_dir


def add_by_hash(new, old, conf, now=None):
    """Index files by their SHA256, plus the old ones still young enough."""
    now = time.time() if now is None else now
    for arch in conf["ARCHES"].split():
        sub = pathlib.Path("dists", conf["SUITE"], conf["COMPONENT"], f"binary-{arch}")
        dest = new / sub / "by-hash" / "SHA256"
        dest.mkdir(parents=True)
        before = old / sub / "by-hash" / "SHA256"
        if before.is_dir():
            for f in before.iterdir():
                if f.name != raye_pages.INDEX and now - f.stat().st_mtime < BY_HASH_DAYS * 86400:
                    shutil.copy2(f, dest / f.name)
        for name in ("Packages", "Packages.gz", "Packages.xz"):
            path = new / sub / name
            target = dest / rp.sha256(path)
            if not target.exists():
                shutil.copy2(path, target)


def sign(suite_dir, conf, keyring=rp.KEYRING):
    release = suite_dir / "Release"
    rp.clearsign(conf, release, suite_dir / "InRelease")
    rp.sign_binary(conf, release, suite_dir / "Release.gpg")
    # the shipped keyring must accept what was just signed, or every
    # installed system would refuse the repo
    if not (rp.verify(keyring, suite_dir / "InRelease")
            and rp.verify(keyring, suite_dir / "Release.gpg", release)):
        raise rp.PublishError(f"the signature does not verify with {keyring}")


def retired_debs(out, conf, chosen, now=None):
    """[(path in the tree, file, the time it left the index)] of the
    packages the new tree keeps out of its index: the ones the old index
    named and the new one does not, plus the ones kept already, while
    younger than GRACE_HOURS."""
    now = time.time() if now is None else now
    if not out.is_dir():
        return []
    indexed = set(published(out, conf).values())
    found = {}
    for rel in indexed:
        if rel not in chosen and (out / rel).is_file():
            found[rel] = now
    pool = out / "pool"
    if pool.is_dir():
        for path in pool.rglob("*.deb"):
            rel = path.relative_to(out).as_posix()
            if rel not in chosen and rel not in indexed:
                found[rel] = path.stat().st_mtime
    keep = [(rel, out / rel, at) for rel, at in found.items() if now - at < GRACE_HOURS * 3600]
    return sorted(keep, key=lambda k: k[2], reverse=True)       # the youngest first


def tree_size(tree):
    return sum(p.stat().st_size for p in tree.rglob("*") if p.is_file())


def keep_retired(new, out, conf, chosen, budget=None, now=None):
    """Copies the old versions still in their grace time into the new tree,
    after its index is written (so no index names them). ([kept], [pruned])."""
    budget = GRACE_BUDGET if budget is None else budget
    room = budget - tree_size(new)
    kept, pruned = [], []
    candidates = retired_debs(out, conf, chosen, now)
    young = {rel for rel, _, _ in candidates}
    for rel, src, at in candidates:
        size = src.stat().st_size
        if size > room:
            pruned.append(rel)
            continue
        dest = new / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        os.chmod(dest, 0o644)
        os.utime(dest, (at, at))
        room -= size
        kept.append(rel)
    if out.is_dir() and (out / "pool").is_dir():
        for path in (out / "pool").rglob("*.deb"):
            rel = path.relative_to(out).as_posix()
            if rel not in chosen and rel not in young and rel not in pruned:
                pruned.append(rel)
    return kept, sorted(pruned)


def build(debs, out, conf, signed=True, keyring=rp.KEYRING, dscs=(), report=None,
          grace_budget=None, now=None):
    files, gone = plan(debs, out, conf)
    if not files:
        raise rp.PublishError("no packages to publish")
    sources = plan_sources(dscs, conf)
    new = out.with_name(out.name + ".new")
    shutil.rmtree(new, ignore_errors=True)
    new.mkdir(parents=True)
    for src, rel, _ in files:
        dest = new / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        os.chmod(dest, 0o644)
    for src, rel in sources:
        dest = new / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        os.chmod(dest, 0o644)
    suite_dir = write_indexes(new, conf)
    add_by_hash(new, out, conf)
    carried = carry_other_suites(new, out, conf)
    kept, pruned = keep_retired(new, out, conf, {rel for _, rel, _ in files} | carried,
                                grace_budget, now)
    if report is not None:
        report.update(kept=kept, pruned=pruned)
    if signed:
        sign(suite_dir, conf, keyring)
    # last: the folder pages are not apt indexes, Release must not name them
    raye_pages.write_folder_pages(new)
    problems = rp.audit_tree(new, conf["SUITE"], keyring, signed=signed)
    if problems:
        shutil.rmtree(new, ignore_errors=True)
        raise rp.PublishError("this tree must not be published:\n  " + "\n  ".join(problems))
    previous = out.with_name(out.name + ".previous")
    shutil.rmtree(previous, ignore_errors=True)
    if out.exists():
        out.rename(previous)
    new.rename(out)
    return files, gone


def promote(out, conf, source, target, signed=True, keyring=rp.KEYRING, report=None):
    """Republishes the exact package set of channel `source` as channel
    `target`, one step up the line Dev -> Beta -> Public Beta -> Stable.
    The files are the ones already in the pool (nothing is built again);
    the other suites are carried over as they are."""
    suites = channel_suites(conf)
    if source not in suites or target not in suites:
        raise rp.PublishError(f"channels are {', '.join(suites)}")
    if suites.index(target) != suites.index(source) - 1:
        up = suites[suites.index(source) - 1] if suites.index(source) else None
        raise rp.PublishError(f"{source} goes up to {up} only" if up else
                              f"{source} is Stable: nothing above it")
    names = sorted(set(published(out, with_suite(conf, source)).values()))
    if not names:
        raise rp.PublishError(f"{source} has no packages in {out}: publish it first")
    debs = []
    for rel in names:
        if not (out / rel).is_file():
            raise rp.PublishError(f"{source} names {rel}, which is missing")
        debs.append(out / rel)
    # build() replaces the tree: work from a copy of the files it reads
    hold = out.with_name(out.name + ".promote")
    shutil.rmtree(hold, ignore_errors=True)
    hold.mkdir(parents=True)
    try:
        copies = []
        for i, deb in enumerate(debs):
            # the pool path is made from the file name: keep it
            dest = hold / f"{i:04d}" / deb.name
            dest.parent.mkdir()
            shutil.copy2(deb, dest)
            copies.append(dest)
        return build(copies, out, with_suite(conf, target), signed=signed, keyring=keyring,
                     report=report)
    finally:
        shutil.rmtree(hold, ignore_errors=True)


def find_debs(dirs):
    debs = []
    for d in dirs:
        found = sorted(pathlib.Path(d).glob("*.deb"))
        if not found:
            raise rp.PublishError(f"no .deb in {d}")
        debs += found
    return debs


def main(argv=None):
    conf = rp.settings()
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--debs", action="append", help=f"folder of .debs (default {conf['DEBS']})")
    ap.add_argument("--out", default=os.path.join(conf["STAGE"], "apt"))
    ap.add_argument("--dry-run", action="store_true", help="say what would change, write nothing")
    ap.add_argument("--no-sign", action="store_true", help="for a test tree only")
    ap.add_argument("--sources", action="append", default=[],
                    help="folder of source packages (.dsc and the files they name)")
    ap.add_argument("--check", metavar="DIR", help="audit a tree, change nothing")
    ap.add_argument("--suite", help=f"the update channel to publish (default {conf['SUITE']}: "
                    "Stable; or " + ", ".join(channel_suites(conf)[1:]) + ")")
    ap.add_argument("--from-suite", metavar="SUITE",
                    help="promote: publish --suite with the exact packages SUITE has now, one channel "
                         "up (Dev -> Beta -> Public Beta -> Stable); nothing is built again")
    args = ap.parse_args(argv)
    if args.from_suite and not args.suite:
        print("publish-repo: --from-suite needs --suite (the channel above it)", file=sys.stderr)
        return 2
    if args.suite:
        try:
            conf = with_suite(conf, args.suite)
        except rp.PublishError as e:
            print(f"publish-repo: {e}", file=sys.stderr)
            return 2
    out = pathlib.Path(args.out)
    if args.check:
        problems = rp.audit_tree(args.check, conf["SUITE"])
        for p in problems:
            print(f"  refused   {p}")
        print(f"{args.check}: " + ("must not be published" if problems else "may be published"))
        return 1 if problems else 0
    report = {"kept": [], "pruned": []}
    try:
        dscs = []
        for d in args.sources:
            found = sorted(pathlib.Path(d).glob("*.dsc"))
            if not found:
                raise rp.PublishError(f"no .dsc in {d}")
            dscs += found
        if args.from_suite and args.dry_run:
            names = sorted(set(published(out, with_suite(conf, args.from_suite)).values()))
            for rel in names:
                print(f"  promote   {rel}")
            print(f"would publish {len(names)} files of {args.from_suite} as {conf['SUITE']} in {out}")
            return 0
        if args.from_suite:
            if not args.no_sign and not rp.have_key(conf):
                raise rp.PublishError(f"no signing key {conf['SIGNING_KEY']} in {conf['GNUPGHOME']}")
            files, gone = promote(out, conf, args.from_suite, conf["SUITE"],
                                  signed=not args.no_sign, report=report)
        debs = [] if args.from_suite else find_debs(args.debs or [conf["DEBS"]])
        if args.from_suite:
            pass
        elif args.dry_run:
            files, gone = plan(debs, out, conf)
        else:
            if not args.no_sign and not rp.have_key(conf):
                raise rp.PublishError(f"no signing key {conf['SIGNING_KEY']} in {conf['GNUPGHOME']}")
            files, gone = build(debs, out, conf, signed=not args.no_sign, dscs=dscs,
                                report=report)
    except (rp.PublishError, subprocess.CalledProcessError) as e:
        print(f"publish-repo: {e}", file=sys.stderr)
        return 1
    for _, rel, note in files:
        print(f"  {note:9} {rel}")
    for name in gone:
        print(f"  retired   {name}" + ("" if args.dry_run else f" (its file stays {GRACE_HOURS} h)"))
    for rel in report["kept"]:
        print(f"  kept      {rel}")
    for rel in report["pruned"]:
        print(f"  removed   {rel}")
    for dsc in dscs:
        print(f"  source    {dsc.name}")
    print(("would write " if args.dry_run else "wrote ") + str(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
