# No smartcard check on the lock screen (pam_sss is not shipped).
raye-desktop  release/pam/kde-smartcard  etc/pam.d/kde-smartcard

# Firefox as Raye's browser (GP-46). Default prefs only, no policies.json:
# a policy makes Firefox say the browser is managed by an organization.
# Measured: this build reads /etc/firefox/defaults/pref, not /etc/firefox/syspref.js.
raye-desktop  release/firefox/raye-defaults.js  etc/firefox/defaults/pref/raye-defaults.js

# Raye Synth: General MIDI that is always there, running only while
# something plays (Windows programs start it when they open it).
