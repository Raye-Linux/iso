"""Turn sleep off on a PC where it does not work, and say so once.

Some PCs freeze for good when they go to sleep (a Dell Latitude 5490 with
Intel graphics was measured on 2026-11-19: the journal of that boot ends
with "PM: suspend entry" and never "PM: suspend exit"). Pressing the power
button for long is then the only way out, every time. Raye notices it and
turns sleep off; closing the lid then locks the PC and turns the screen off.

    raye-sleep-guard pre <mode>    systemd-sleep hook, before sleep: writes a
                                   mark on disk and syncs it
    raye-sleep-guard post <mode>   after waking: takes the mark away; a wake
                                   clears the count of failed sleeps
    raye-sleep-guard boot          at every start, as root, before sign-in:
                                   a mark left from an earlier start means
                                   that sleep never came back
    raye-sleep-guard enable        Settings' "Turn sleep back on", as root
                                   through pkexec
    raye-sleep-guard notice        in the session: one notice for each new
                                   step, and the lid made to lock the PC
    raye-sleep-guard status        the state, as JSON

The rule, decided at boot:
  - a mark left by an earlier start is a failed sleep, unless the battery
    may simply have run out while the PC slept (it slept on battery and the
    battery is at 5 % or less now, or unknown and the sleep is more than
    3 hours old): then nothing is counted, either way;
  - the first failed sleep only warns: "if it happens again, sleep is
    turned off";
  - a second failed sleep in a row turns sleep off;
  - any wake from sleep resets the count;
  - a PC of the known list (no-sleep.list) has sleep off from the start;
  - "Turn sleep back on" in Settings wins over the list; the count starts
    again from zero, so two more failures turn sleep off again.

Sleep is turned off by /run/systemd/sleep.conf.d/50-raye-sleep-guard.conf,
written again at every start from the state: logind then answers "no" to
CanSuspend, Plasma shows no Sleep entry, and the power daemon's lid
default becomes "turn off the screen", which Raye's powerdevilrc makes
lock first. Hibernation is left alone.
"""
import glob
import json
import os
import pathlib
import subprocess
import sys
import time

STATE_DIR = "var/lib/raye/sleep-guard"
MARK = STATE_DIR + "/sleeping"
STATE = STATE_DIR + "/state.json"
DROPIN = "run/systemd/sleep.conf.d/50-raye-sleep-guard.conf"
LIST = "usr/share/raye/sleep-guard/no-sleep.list"
DMI = "sys/class/dmi/id"
SUPPLIES = "sys/class/power_supply"
BOOT_ID = "proc/sys/kernel/random/boot_id"

# the modes that go through suspend to RAM or s2idle
WATCHED = {"suspend", "hybrid-sleep", "suspend-then-hibernate"}
FLAT_BATTERY = 5          # percent: at or below, the battery may have run out
UNKNOWN_BATTERY_AGE = 3 * 3600
FAILURES_TO_TURN_OFF = 2

DROPIN_TEXT = """\
# Written by Raye at every start: sleep does not work on this PC.
# Settings > System > Power turns it back on.
[Sleep]
AllowSuspend=no
AllowHybridSleep=no
AllowSuspendThenHibernate=no
"""

# powerdevilrc, what is changed while sleep is off: (key, sleep value,
# value used instead). "Sleep" on the lid would do nothing at all.
POWERDEVIL_SOURCES = ("AC", "Battery", "LowBattery")
POWERDEVIL_KEYS = (("LidAction", 1, 64),           # sleep -> lock, screen off
                   ("PowerButtonAction", 1, 16),   # sleep -> ask
                   ("AutoSuspendAction", 1, 0))    # sleep when idle -> nothing


def root_dir():
    # pkexec passes no environment; a run by it never takes another root
    if os.environ.get("PKEXEC_UID"):
        return pathlib.Path("/")
    return pathlib.Path(os.environ.get("RAYE_SLEEP_ROOT") or "/")


# ------------------------------------------------------------------ files

def read_text(path):
    try:
        return pathlib.Path(path).read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return None


def read_json(path):
    text = read_text(path)
    if not text:
        return None
    try:
        data = json.loads(text)
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def write_synced(path, text, mode=0o644):
    """Write, fsync the file and its folder: it must survive a freeze."""
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, mode)
    try:
        os.write(fd, text.encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    os.chmod(tmp, mode)
    os.replace(tmp, path)
    sync_dir(path.parent)


def remove_synced(path):
    path = pathlib.Path(path)
    try:
        path.unlink()
    except FileNotFoundError:
        return False
    sync_dir(path.parent)
    return True


def sync_dir(folder):
    try:
        fd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


DEFAULT_STATE = {"failures": 0, "status": "ok", "reason": "", "event": 0, "user_on": False}


def load_state(root):
    state = dict(DEFAULT_STATE)
    data = read_json(root / STATE)
    if data:
        for key, default in DEFAULT_STATE.items():
            value = data.get(key, default)
            if isinstance(value, type(default)):
                state[key] = value
    if state["status"] not in ("ok", "warned", "off"):
        state["status"] = "ok"
    return state


def save_state(root, state):
    """Kept only when it says something: a PC that sleeps well has no file."""
    if state == DEFAULT_STATE:
        remove_synced(root / STATE)
        return
    state = dict(state, changed=int(time.time()))
    write_synced(root / STATE, json.dumps(state, sort_keys=True) + "\n")


# ------------------------------------------------------------------ machine

def boot_id(root):
    return read_text(root / BOOT_ID) or ""


def power(root):
    """(on mains, battery percent): None for what is not known."""
    mains = None
    levels = []
    for supply in sorted(glob.glob(str(root / SUPPLIES / "*"))):
        kind = read_text(supply + "/type")
        if kind == "Mains":
            online = read_text(supply + "/online")
            if online in ("0", "1"):
                mains = bool(mains) or online == "1"
        elif kind == "Battery" and read_text(supply + "/scope") != "Device":
            level = read_text(supply + "/capacity")
            if level and level.isdigit():
                levels.append(int(level))
    battery = min(levels) if levels else None
    return mains, battery


def machine(root):
    vendor = read_text(root / DMI / "sys_vendor") or ""
    product = read_text(root / DMI / "product_name") or ""
    return vendor, product


def known_bad(root, vendor, product):
    """True when the list names this PC: "vendor | product" per line."""
    text = read_text(root / LIST) or ""
    for line in text.splitlines():
        line = line.split("#", 1)[0].strip()
        if "|" not in line:
            continue
        v, p = (part.strip() for part in line.split("|", 1))
        if v and p and v == vendor.strip() and p == product.strip():
            return True
    return False


# ------------------------------------------------------------------ decisions

def judge(mark, battery_now, now):
    """'failed' or 'unclear' for a mark left by an earlier start."""
    if mark.get("ac") is False:
        if battery_now is not None:
            if battery_now <= FLAT_BATTERY:
                return "unclear"
        else:
            started = mark.get("time")
            if not isinstance(started, (int, float)) or now - started > UNKNOWN_BATTERY_AGE:
                return "unclear"
    return "failed"


def after_failure(state):
    state["failures"] += 1
    if state["status"] == "off":
        return
    if state["failures"] >= FAILURES_TO_TURN_OFF:
        state.update(status="off", reason="failed")
        state["event"] += 1
    elif state["status"] == "ok":
        state["status"] = "warned"
        state["event"] += 1


def pre(root, mode):
    if mode not in WATCHED:
        return 0
    mains, battery = power(root)
    mark = {"boot": boot_id(root), "time": int(time.time()), "mode": mode,
            "ac": mains, "battery": battery}
    write_synced(root / MARK, json.dumps(mark, sort_keys=True) + "\n")
    # the rest of the disk too, while it still can be
    os.sync()
    return 0


def post(root, mode):
    if mode not in WATCHED:
        return 0
    removed = remove_synced(root / MARK)
    state = load_state(root)
    if removed or state["failures"]:
        state["failures"] = 0
        if state["status"] == "warned":
            state["status"] = "ok"
        save_state(root, state)
    return 0


def boot(root, now=None, log=print):
    now = time.time() if now is None else now
    state = load_state(root)
    mark = read_json(root / MARK)
    if mark is not None and mark.get("boot") != boot_id(root):
        _, battery = power(root)
        verdict = judge(mark, battery, now)
        if verdict == "failed":
            after_failure(state)
            log("the last sleep (%s) never came back: %d in a row" % (mark.get("mode"), state["failures"]))
        else:
            log("the last sleep did not come back, but the battery may have run out: not counted")
        remove_synced(root / MARK)
    elif mark is None and (root / MARK).exists():
        remove_synced(root / MARK)      # unreadable: written halfway

    vendor, product = machine(root)
    listed = known_bad(root, vendor, product)
    if listed and not state["user_on"] and state["status"] != "off":
        state.update(status="off", reason="model")
        state["event"] += 1
        log("%s %s does not wake from sleep: sleep turned off" % (vendor, product))
    elif state["status"] == "off" and state["reason"] == "model" and not listed:
        # the list no longer names it (an update): sleep comes back quietly
        state.update(status="ok", reason="", failures=0)

    if state["status"] == "off":
        write_synced(root / DROPIN, DROPIN_TEXT)
    else:
        remove_synced(root / DROPIN)
    save_state(root, state)
    return 0


def enable(root):
    state = load_state(root)
    state.update(status="ok", reason="", failures=0, user_on=True)
    remove_synced(root / MARK)
    remove_synced(root / DROPIN)
    save_state(root, state)
    return 0


# ------------------------------------------------------------------ session

WORDS = {
    "en": {
        "app": "Power",
        "off_title": "Sleep is turned off on this PC",
        "off_body": "Sleep doesn't work on this PC, so Raye turned it off.",
        "off_lid": "Closing the lid locks the PC and turns off the screen.",
        "off_where": "You can turn sleep back on in Settings > System > {page}.",
        "warn_title": "This PC didn't wake up from sleep",
        "warn_body": "The last time this PC went to sleep, it didn't come back. "
                     "If it happens again, Raye will turn sleep off on this PC.",
        "warn_lid": "Closing the lid will then lock the PC and turn off the screen.",
        "page_battery": "Power & battery",
        "page": "Power",
        "open": "Open Settings",
    },
    "fr": {
        "app": "Alimentation",
        "off_title": "La mise en veille est désactivée sur ce PC",
        "off_body": "La mise en veille ne fonctionne pas sur ce PC, alors Raye l'a désactivée.",
        "off_lid": "Fermer le capot verrouille le PC et éteint l'écran.",
        "off_where": "Vous pouvez la réactiver dans Paramètres > Système > {page}.",
        "warn_title": "Ce PC ne s'est pas réveillé de la mise en veille",
        "warn_body": "La dernière fois que ce PC s'est mis en veille, il ne s'est pas réveillé. "
                     "Si cela se reproduit, Raye désactivera la mise en veille sur ce PC.",
        "warn_lid": "Fermer le capot verrouillera alors le PC et éteindra l'écran.",
        "page_battery": "Alimentation et batterie",
        "page": "Alimentation",
        "open": "Ouvrir les Paramètres",
    },
}

OPEN_POWER = ["raye-settings", "--page", "system/power"]


def language(env=os.environ):
    for key in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        value = env.get(key, "")
        if value:
            return "fr" if value.split(":")[0].lower().startswith("fr") else "en"
    return "en"


def has_lid(root):
    return bool(glob.glob(str(root / "proc/acpi/button/lid/*/state")))


def has_battery(root):
    return power(root)[1] is not None


def message(state, words, lid, battery):
    """(title, body) for the state, or None when there is nothing to say."""
    page = words["page_battery" if battery else "page"]
    if state["status"] == "off":
        parts = [words["off_body"]]
        if lid:
            parts.append(words["off_lid"])
        parts.append(words["off_where"].format(page=page))
        return words["off_title"], " ".join(parts)
    if state["status"] == "warned":
        parts = [words["warn_body"]]
        if lid:
            parts.append(words["warn_lid"])
        return words["warn_title"], " ".join(parts)
    return None


def user_state_path(env=os.environ):
    base = env.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local/state")
    return pathlib.Path(base, "raye/sleep-guard.json")


def kread(group, key):
    try:
        return subprocess.run(["kreadconfig6", "--file", "powerdevilrc", "--group", group,
                               "--group", "SuspendAndShutdown", "--key", key],
                              capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def kwrite(group, key, value):
    cmd = ["kwriteconfig6", "--file", "powerdevilrc", "--notify", "--group", group,
           "--group", "SuspendAndShutdown", "--key", key]
    cmd += ["--delete"] if value is None else [str(value)]
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def fit_power_settings(sleep_off, changed, read=kread, write=kwrite):
    """While sleep is off, what would sleep does something useful instead.

    `changed` lists what this did before ("AC/LidAction", ...); it is put
    back (the key deleted, so the daemon's default applies again) when
    sleep is back on and the value is still the one written here.
    Returns the new list."""
    changed = list(changed)
    if sleep_off:
        for source in POWERDEVIL_SOURCES:
            for key, sleep_value, instead in POWERDEVIL_KEYS:
                name = "%s/%s" % (source, key)
                if read(source, key) == str(sleep_value):
                    write(source, key, instead)
                    if name not in changed:
                        changed.append(name)
        return changed
    keep = []
    for name in changed:
        source, _, key = name.partition("/")
        instead = dict((k, v) for k, _, v in POWERDEVIL_KEYS).get(key)
        if instead is not None and read(source, key) == str(instead):
            write(source, key, None)
    return keep


def refresh_power_daemon():
    try:
        subprocess.run(["busctl", "--user", "--timeout=5", "call", "org.kde.Solid.PowerManagement",
                        "/org/kde/Solid/PowerManagement", "org.kde.Solid.PowerManagement", "refreshStatus"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def show(title, body, words):
    """Shows it and waits for the button. False when nothing could show it."""
    try:
        res = subprocess.run(["notify-send", "--app-name=" + words["app"], "--icon=system-suspend",
                              "--urgency=normal", "--action=open=" + words["open"], "--wait", title, body],
                             capture_output=True, text=True)
    except OSError:
        return False
    if res.stdout.strip() == "open":
        try:
            subprocess.Popen(OPEN_POWER, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass
    return True


def notice(root, env=os.environ, read=kread, write=kwrite, send=show, refresh=refresh_power_daemon):
    state = load_state(root)
    path = user_state_path(env)
    mine = read_json(path) or {}
    seen = mine.get("seen", 0) if isinstance(mine.get("seen"), int) else 0
    before = mine.get("changed", []) if isinstance(mine.get("changed"), list) else []
    changed = fit_power_settings(state["status"] == "off", before, read, write)
    if changed != before:
        refresh()
    words = WORDS[language(env)]
    said = message(state, words, has_lid(root), has_battery(root))
    new_seen = seen
    if said and state["event"] > seen:
        new_seen = state["event"]
    if new_seen != seen or changed != before:
        try:
            write_synced(path, json.dumps({"seen": new_seen, "changed": changed}) + "\n", 0o600)
        except OSError:
            pass
    if said and new_seen != seen:
        send(said[0], said[1], words)
    return 0


# ------------------------------------------------------------------ main

def main(argv):
    root = root_dir()
    cmd = argv[1] if len(argv) > 1 else ""
    if os.environ.get("PKEXEC_UID") and cmd != "enable":
        print("raye-sleep-guard: only 'enable' through pkexec", file=sys.stderr)
        return 2
    try:
        if cmd in ("pre", "post"):
            mode = argv[2] if len(argv) > 2 else os.environ.get("SYSTEMD_SLEEP_ACTION", "")
            return (pre if cmd == "pre" else post)(root, mode)
        if cmd == "boot":
            return boot(root)
        if cmd == "enable":
            return enable(root)
        if cmd == "notice":
            return notice(root)
        if cmd == "status":
            print(json.dumps(load_state(root), sort_keys=True))
            return 0
    except OSError as err:
        print("raye-sleep-guard: %s" % err, file=sys.stderr)
        # a sleep hook never stands in the way of sleep
        return 0 if cmd in ("pre", "post") else 1
    print("usage: raye-sleep-guard pre|post <mode> | boot | enable | notice | status", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
