[Unit]
Description=Install the graphics driver this computer needs
# No network-online.target here: wanted from multi-user.target it held
# every start, up to a minute without a network, even once the driver
# is in and this unit is skipped. It waits for the network itself.
After=NetworkManager.service

[Service]
Type=oneshot
# not done yet, the NVIDIA Control Panel to add, or new graphics cards:
# anything else skips the unit at once, without waiting for the network
ExecCondition=/usr/libexec/raye-drivers --needed
ExecStartPre=-/usr/bin/nm-online -q -t 60
ExecStart=/usr/libexec/raye-drivers
SuccessExitStatus=75
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
