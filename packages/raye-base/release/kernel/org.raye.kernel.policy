<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Raye Linux</vendor>
  <action id="org.raye.kernel">
    <description>Change the kernel this computer starts</description>
    <description xml:lang="fr">Changer le noyau que l'ordinateur démarre</description>
    <message>Changing the kernel needs your password</message>
    <message xml:lang="fr">Changer de noyau demande votre mot de passe</message>
    <!-- this one asks for the password: it changes what the computer boots -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raye-kernel-setup</annotate>
  </action>
  <action id="org.raye.kernel.tpm-status">
    <description>Check whether the security chip opens the disk by itself</description>
    <description xml:lang="fr">Vérifier si la puce de sécurité ouvre le disque toute seule</description>
    <message>Checking the security chip needs your password</message>
    <message xml:lang="fr">Vérifier la puce de sécurité demande votre mot de passe</message>
    <!-- read only: the person at the computer is not asked anything.
         pkexec picks this action only when the first argument is tpm-status -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raye-kernel-setup</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">tpm-status</annotate>
  </action>
</policyconfig>
