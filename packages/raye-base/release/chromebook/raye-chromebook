#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""Chromebooks (Intel and AMD, with MrChromebox firmware or RW_LEGACY).

  raye-chromebook keys        at boot, before keyd: writes the top-row
                              mapping to /etc/keyd/raye-chromebook.conf
  raye-chromebook sound-tip   in the session: one notice if there is no
                              sound output, pointing to the handbook

On anything that is not a Chromebook both do nothing, and "keys" takes
back a file it wrote earlier (a disk moved to another computer).
"""
import os
import pathlib
import subprocess
import sys
import time

CONF = "etc/keyd/raye-chromebook.conf"
MARK = "# Written by Raye at every start. Delete this line to keep your own changes."

# Boards whose keyboard is a regular laptop one, with its own Fn key.
OWN_KEYBOARD = {"sarien", "arcada"}
# Pixelbook, Pixelbook Go and Pixel Slate: no physmap, and no Forward key.
PIXEL = {"eve", "atlas", "nocturne"}
# SMBIOS chassis types of machines without a built-in keyboard (desktop,
# tower, all-in-one...): a Chromebox or Chromebase.
NO_BUILT_IN = {"3", "4", "5", "6", "7", "13", "15", "16", "35"}

# AT keyboard, the EC keyboard, the Pixel Slate's keyboard cover
IDS = ("k:0001:0001", "k:0000:0000", "k:18d1:5030")

# function_row_physmap codes: what the kernel calls the key, and what Raye
# makes it do. Same table as the community's keyboard maps.
VIVALDI = {
    "EA": ("back", "back"),
    "E9": ("forward", "forward"),
    "E7": ("refresh", "refresh"),
    "91": ("zoom", "f11"),            # full screen; apps know F11, few know zoom
    "92": ("scale", "M-tab"),         # overview: Task View
    "93": ("sysrq", "sysrq"),
    "DD": ("sysrq", "sysrq"),
    "94": ("brightnessdown", "brightnessdown"),
    "95": ("brightnessup", "brightnessup"),
    "97": ("kbdillumdown", "kbdillumdown"),
    "98": ("kbdillumup", "kbdillumup"),
    "9E": ("kbdillumtoggle", "kbdillumtoggle"),
    "90": ("previoussong", "previoussong"),
    "99": ("nextsong", "nextsong"),
    "9A": ("playpause", "playpause"),
    "9B": ("micmute", "micmute"),
    "A0": ("mute", "mute"),
    "AE": ("volumedown", "volumedown"),
    "B0": ("volumeup", "volumeup"),
}
# Older keyboards send F1-F10 and print this row on them.
CLASSIC = ("back", "forward", "refresh", "f11", "M-tab",
           "brightnessdown", "brightnessup", "mute", "volumedown", "volumeup")
PIXEL_ROW = ("back", "refresh", "f11", "M-tab", "brightnessdown",
             "brightnessup", "playpause", "mute", "volumedown", "volumeup")

HANDBOOK = "https://github.com/Raye-Linux/handbook/blob/main/{lang}/11-chromebooks.md#sound"
WORDS = {
    "en": ("Sound is not working yet",
           "This Chromebook needs a fix for its speakers and microphone.",
           "How to fix it"),
    "fr": ("Le son ne marche pas encore",
           "Ce Chromebook a besoin d'une réparation pour ses haut-parleurs et son micro.",
           "Comment le réparer"),
}


def read(root, rel):
    try:
        return (pathlib.Path(root) / rel).read_text().strip()
    except OSError:
        return ""


def dmi(root="/"):
    names = ("sys_vendor", "product_family", "product_name", "chassis_type")
    return {n: read(root, "sys/class/dmi/id/" + n) for n in names}


def is_chromebook(info):
    """Google's firmware (stock or MrChromebox) says Google as the maker;
    old boards say GOOGLE, and some HP ones only say it in the family."""
    vendor = info.get("sys_vendor", "").lower()
    family = info.get("product_family", "").lower()
    if info.get("product_name", "").lower() == "crosvm":
        return False                  # ChromeOS' own Linux container
    return vendor == "google" or family.startswith("google")


def keyboard_kind(info):
    """None (leave the keyboard alone), "pixel" or "chromebook"."""
    if not is_chromebook(info):
        return None
    board = info.get("product_name", "").lower()
    if board in OWN_KEYBOARD or info.get("chassis_type", "") in NO_BUILT_IN:
        return None
    return "pixel" if board in PIXEL else "chromebook"


def physmap(root="/"):
    text = read(root, "sys/bus/platform/devices/i8042/serio0/function_row_physmap")
    return [code.upper() for code in text.split()]


def top_row(kind, codes):
    """[(key the kernel sends, what it should do)], left to right."""
    known = [c for c in codes if c in VIVALDI]
    if kind == "chromebook" and known:
        # a code we do not know keeps its place, so F-numbers stay right
        return [VIVALDI.get(c, (None, None)) for c in codes]
    row = PIXEL_ROW if kind == "pixel" else CLASSIC
    return [(f"f{i}", action) for i, action in enumerate(row, 1)]


def keyd_config(row):
    main, meta, alt, control, ctlalt = [], [], ["backspace = delete"], [], \
        ["backspace = C-A-delete"]
    for i, (key, action) in enumerate(row, 1):
        if key is None:
            continue
        if action != key:
            main.append(f"{key} = {action}")
        meta.append(f"{key} = f{i}")      # Search + key: the F-key
        ctlalt.append(f"{key} = C-A-f{i}")
        if action in ("brightnessdown", "brightnessup"):
            alt.append(f"{key} = kbdillum{action[10:]}")
        if action == "M-tab":
            control.append(f"{key} = sysrq")
    main += ["f13 = coffee", "sleep = coffee"]   # the lock key
    # keyd wants [ids] first; the mark goes right under it
    parts = ["[ids]", MARK, *IDS, "", "[main]", *main, "", "[meta]", *meta,
             "", "[alt]", *alt, "", "[control]", *control, "",
             "[control+alt]", *ctlalt]
    return "\n".join(parts) + "\n"


def other_configs(root):
    folder = pathlib.Path(root) / "etc/keyd"
    mine = pathlib.Path(root) / CONF
    return sorted(p for p in folder.glob("*.conf") if p != mine) if folder.is_dir() else []


def ours(path):
    try:
        return path.read_text().splitlines()[:2] == ["[ids]", MARK]
    except OSError:
        return False


def plan_keys(root="/"):
    """("write", text), ("remove", None) or ("keep", why)."""
    path = pathlib.Path(root) / CONF
    kind = keyboard_kind(dmi(root))
    if kind is None:
        return ("remove", None) if ours(path) else ("keep", "not a Chromebook keyboard")
    if path.exists() and not ours(path):
        return ("keep", f"{path} was changed by hand")
    others = other_configs(root)
    if others:
        # keyd lets a keyboard be named in one file only
        return ("keep", "keyd is already set up: " + ", ".join(p.name for p in others))
    text = keyd_config(top_row(kind, physmap(root)))
    if path.exists() and path.read_text() == text:
        return ("keep", "up to date")
    return ("write", text)


def restart_keyd():
    # --no-block: at boot keyd waits for this unit, a blocking call would hang
    subprocess.run(["systemctl", "--no-block", "restart", "keyd.service"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def keys(root="/"):
    action, data = plan_keys(root)
    path = pathlib.Path(root) / CONF
    if action == "write":
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        tmp.write_text(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
        print(f"raye-chromebook: top row mapped in {path}")
    elif action == "remove":
        path.unlink()
        print("raye-chromebook: not a Chromebook, mapping removed")
    else:
        print(f"raye-chromebook: keyboard left as it is ({data})")
        return 0
    if root == "/":
        restart_keyd()
    return 0


def no_sound(inspect_rc, inspect_out):
    """wpctl inspect @DEFAULT_AUDIO_SINK@: no default sink at all, or only
    the dummy one PipeWire makes when no card works."""
    return inspect_rc != 0 or 'node.name = "auto_null"' in inspect_out


def language():
    for name in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(name, "")
        if value:
            return "fr" if value.startswith("fr") else "en"
    return "en"


def sound_tip(root="/", wait=30):
    if not is_chromebook(dmi(root)):
        return 0
    state = pathlib.Path(os.environ.get("XDG_STATE_HOME") or
                         pathlib.Path.home() / ".local/state") / "raye/chromebook-sound-tip"
    if state.exists():
        return 0
    time.sleep(wait)                  # let PipeWire find the cards
    try:
        got = subprocess.run(["wpctl", "inspect", "@DEFAULT_AUDIO_SINK@"],
                             capture_output=True, text=True, timeout=10)
        rc, out = got.returncode, got.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 0                      # cannot tell: say nothing
    if not no_sound(rc, out):
        return 0
    lang = language()
    title, body, button = WORDS[lang]
    state.parent.mkdir(parents=True, exist_ok=True)
    state.touch()
    try:
        answer = subprocess.run(
            ["notify-send", "--app-name=Raye", "--icon=audio-volume-muted",
             f"--action=open={button}", "--wait", title, body],
            capture_output=True, text=True).stdout.strip()
    except OSError:
        return 0
    if answer == "open":
        subprocess.run(["xdg-open", HANDBOOK.format(lang=lang)])
    return 0


def main(argv):
    if argv[1:] == ["keys"]:
        return keys()
    if argv[1:] == ["sound-tip"]:
        return sound_tip()
    print("usage: raye-chromebook keys | sound-tip", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
