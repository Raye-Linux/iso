#!/bin/sh
set -e

# filled in at build time, see raye-desktop.preinst
DIVERT="#RAYE_DIVERT#"

# Firewall profiles an older Raye opened to every network: phone pairing,
# and the replies of PCs and NAS found on the network.
PROFILES="raye-phone raye-network-discovery"
# set once those rules were taken back (private networks now reach them)
PROFILES_PRIVATE=/var/lib/raye-desktop/firewall-profiles-private
# set once printing has been made to start on demand
CUPS_ON_DEMAND=/var/lib/raye-desktop/cups-on-demand
# set once fluidsynth's own unit has been turned off
SYNTH_OFF=/var/lib/raye-desktop/fluidsynth-off
# set once the Store's Steam may see the other drives
STEAM_DRIVES=/var/lib/raye-desktop/steam-drives

if [ "$1" = configure ]; then
    # A file this version no longer replaces gets its stock one back.
    # --list does not filter by package: keep the lines that end in ours
    dpkg-divert --list | while read -r kind _ file _ to _ owner; do
        [ "$kind" = diversion ] && [ "$owner" = raye-desktop ] || continue
        case " $DIVERT " in
            *" $file "*) continue ;;
        esac
        dpkg-divert --package raye-desktop --remove --rename --divert "$to" "$file"
    done

    # Electron apps from the Store draw sharp at any scale instead of
    # going through the X11 layer.
    if command -v flatpak >/dev/null 2>&1; then
        flatpak override --system --env=ELECTRON_OZONE_PLATFORM_HINT=auto || true
    fi

    # The Store's Steam is a Flatpak: it only sees the home folder, so a
    # library on a second disk could not be added. Disks are mounted under
    # /media, /run/media (the file manager) or /mnt (the fstab). Set once,
    # in new installs and updates alike, so a path someone takes away in
    # the app's permissions stays away. Works before Steam is installed.
    if [ ! -e "$DPKG_ROOT$STEAM_DRIVES" ] && command -v flatpak >/dev/null 2>&1; then
        if flatpak override --system --filesystem=/media --filesystem=/run/media \
                --filesystem=/mnt com.valvesoftware.Steam; then
            mkdir -p "$DPKG_ROOT${STEAM_DRIVES%/*}"
            : > "$DPKG_ROOT$STEAM_DRIVES"
        fi
    fi

    # Pairing with a phone and finding shared folders work on private
    # networks through raye-network-profile. The rules an older Raye added
    # opened them on public networks too: taken back once, so one a person
    # adds again in the firewall's window stays.
    if [ ! -e "$DPKG_ROOT$PROFILES_PRIVATE" ] && command -v ufw >/dev/null 2>&1 &&
            LC_ALL=C ufw status 2>/dev/null | grep -q '^Status: active'; then
        for profile in $PROFILES; do
            [ -e "$DPKG_ROOT/etc/ufw/applications.d/$profile" ] || continue
            ufw delete allow "$profile" >/dev/null 2>&1 || true
        done
        mkdir -p "$DPKG_ROOT${PROFILES_PRIVATE%/*}"
        : > "$DPKG_ROOT$PROFILES_PRIVATE"
    fi

    # No print server at boot: cups.socket starts it when a program
    # prints, cups.path when a queue exists, and it quits once idle.
    # Done once, so someone who turns cups.service back on keeps it.
    # Disabling the service follows its Also= and takes the socket and
    # the path unit along, hence the enable after it.
    if [ ! -e "$DPKG_ROOT$CUPS_ON_DEMAND" ] && command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable cups.service >/dev/null || true
        deb-systemd-helper enable cups.socket cups.path >/dev/null || true
        mkdir -p "$DPKG_ROOT${CUPS_ON_DEMAND%/*}"
        : > "$DPKG_ROOT$CUPS_ON_DEMAND"
    fi

    # fluidsynth's own unit would run a synth in every account from
    # sign-in; Raye Synth starts only when something plays. Done once:
    # fluidsynth's upgrades keep it off, and someone who wants it keeps it.
    if [ ! -e "$DPKG_ROOT$SYNTH_OFF" ] && command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper --user disable fluidsynth.service >/dev/null || true
        mkdir -p "$DPKG_ROOT${SYNTH_OFF%/*}"
        : > "$DPKG_ROOT$SYNTH_OFF"
    fi
fi

#DEBHELPER#

exit 0
