"""Keeps a folder in the home with every installed Windows program, the
way Program Files is on Windows: "Windows programs" ("Programmes Windows"
in French), one link per program folder, in whichever space it lives.

    raye-windows-programs        bring the folder in line with the spaces

Program folders are those under Program Files, Program Files (x86) and
the per-person AppData\\Local\\Programs of each space, minus the ones
every space has. The folder is made when the first program is installed
and goes away with the last one. Only its own links are ever touched:
anything the person puts in it stays.

raye-run-windows runs this after each setup, program and uninstall.
"""
import os
import sys

NAMES = ("Windows programs", "Programmes Windows")

# what a space has before anything is installed
OWN = {
    "common files", "internet explorer", "windows media player", "windows nt", "windowspowershell",
    "microsoft", "microsoft.net", "windows defender", "windows mail", "windows photo viewer",
    "windows sidebar", "windows portable devices", "windows kits", "reference assemblies",
    "msbuild", "dotnet", "uninstall information", "modifiablewindowsapps", "common",
}

DIRECTORY = "[Desktop Entry]\nIcon=folder-windows\n"


def program_folders(space):
    c = os.path.join(space, "drive_c")
    tops = [os.path.join(c, "Program Files"), os.path.join(c, "Program Files (x86)")]
    users = os.path.join(c, "users")
    try:
        for user in sorted(os.listdir(users)):
            tops.append(os.path.join(users, user, "AppData", "Local", "Programs"))
    except OSError:
        pass
    found = []
    for top in tops:
        try:
            names = sorted(os.listdir(top))
        except OSError:
            continue
        for name in names:
            path = os.path.join(top, name)
            if name.lower() not in OWN and not os.path.islink(path) and os.path.isdir(path):
                found.append((name, path))
    return found


def wanted(root):
    links = {}
    try:
        spaces = sorted(os.listdir(root))
    except OSError:
        return links
    for slug in spaces:
        space = os.path.join(root, slug)
        if slug.startswith(".") or not os.path.isdir(os.path.join(space, "drive_c")):
            continue
        for name, path in program_folders(space):
            label, n = name, 2
            while label in links:
                label = f"{name} ({n})"
                n += 1
            links[label] = path
    return links


def ours(path, root):
    """A link this tool made: it points into the spaces."""
    try:
        target = os.readlink(path)
    except OSError:
        return False
    return target.startswith(root.rstrip("/") + "/")


def folder_name(home, lang):
    for name in NAMES:
        if os.path.isdir(os.path.join(home, name)):
            return os.path.join(home, name)
    return os.path.join(home, NAMES[1] if lang.startswith("fr") else NAMES[0])


def sync(root, home, lang):
    """Returns the folder, or None when there is none (nothing installed)."""
    want = wanted(root)
    folder = folder_name(home, lang)
    if not want and not os.path.isdir(folder):
        return None
    os.makedirs(folder, exist_ok=True)
    for entry in os.listdir(folder):
        path = os.path.join(folder, entry)
        if os.path.islink(path) and ours(path, root) and os.readlink(path) != want.get(entry):
            os.unlink(path)
    for label, target in want.items():
        path = os.path.join(folder, label)
        if not os.path.lexists(path):
            os.symlink(target, path)
    marker = os.path.join(folder, ".directory")
    if not want:
        # empty but for the icon: it was only ever ours
        if os.listdir(folder) in ([], [".directory"]):
            if os.path.exists(marker):
                os.unlink(marker)
            os.rmdir(folder)
            return None
        return folder
    if not os.path.exists(marker):
        with open(marker, "w", encoding="utf-8") as f:
            f.write(DIRECTORY)
    return folder


def main():
    home = os.path.expanduser("~")
    data = os.environ.get("XDG_DATA_HOME") or os.path.join(home, ".local", "share")
    lang = ""
    for key in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(key):
            lang = os.environ[key]
            break
    try:
        sync(os.path.join(data, "raye", "windows"), home, lang)
    except OSError as e:
        print(f"raye-windows-programs: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
