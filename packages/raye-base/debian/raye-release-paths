# Light at idle (helpers that start only when they have something to do).
raye-desktop  release/tuning/raye-start-if-needed  usr/libexec/raye-start-if-needed
# Light mode on a PC with little memory (2 to 4 GB): effects and the file
# index off at an account's first sign-in, and the Store and the Windows
# space wait at start; raye-desktop.links makes it a system and a user
# generator too. Nothing happens with 4 GB or more.
raye-desktop  release/lightmode/raye-light-mode          usr/libexec/raye-light-mode
raye-desktop  release/lightmode/raye-light-mode.service  usr/lib/systemd/user/raye-light-mode.service
# A visible mouse pointer in a virtual machine: the desktop draws it
# itself, because a virtual GPU's cursor plane is not shown in a console
# or over SPICE. Read by the user manager, inherited by the session.
raye-desktop  release/tuning/raye-vm-cursor  usr/lib/systemd/user-environment-generators/90-raye-vm-cursor
# On AMD cards, until the kernel shows RGBA8888, the desktop and the
# sign-in screen draw the pointer themselves (a black screen otherwise).
# raye-desktop.links makes it a user-environment generator too.
raye-system   release/tuning/raye-amd-cursor  usr/libexec/raye-amd-cursor
raye-desktop  release/tuning/sddm-wayland-raye.conf  etc/sddm.conf.d/sddm-wayland-raye.conf
raye-desktop  release/tuning/raye-amd-cursor-guard  usr/libexec/raye-amd-cursor-guard
