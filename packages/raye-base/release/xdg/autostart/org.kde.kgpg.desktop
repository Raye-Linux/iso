# Raye: KGpg (KDE's key manager) has no place in a Raye sign-in. Raye
# never installs it, but a package a person installs can bring it, and its
# first start opens the KGpg Assistant over the desktop. It is still there
# to open by hand.
[Desktop Entry]
Type=Application
Name=KGpg
Exec=kgpg %U
TryExec=/usr/bin/kgpg
Icon=kgpg
Hidden=true
