#!/bin/sh
# Boot entry "earlier states": the kernel line carries raye.go-back=N.
# Point N becomes the system (snapshot-restore go-back, as Settings does),
# then the computer restarts into it. If that fails, it starts as it is.
#
# RAYE_GO_BACK_CMDLINE and RAYE_GO_BACK_TOOL stand in for /proc/cmdline
# and snapshot-restore in the tests.
set -u

cmdline=${RAYE_GO_BACK_CMDLINE:-/proc/cmdline}
tool=${RAYE_GO_BACK_TOOL:-/usr/libexec/raye-settings/snapshot-restore}

n=$(tr ' ' '\n' < "$cmdline" | sed -n 's/^raye\.go-back=\([0-9][0-9]*\)$/\1/p' | head -n 1)
[ -n "$n" ] || exit 0

# the boot theme has the words for these keys, in the system's language
plymouth display-message --text=raye:go-back 2>/dev/null
if [ -x "$tool" ] && "$tool" go-back "$n" | grep -qx done; then
    systemctl --no-block reboot
    exit 0
fi
echo "raye-go-back-at-boot: going back to restore point $n failed" >&2
plymouth display-message --text=raye:go-back-failed 2>/dev/null
sleep 8
plymouth display-message --text=raye:clear 2>/dev/null
exit 0
