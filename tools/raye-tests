SKIP_CODE = 77                      # ctest's, and four tests of this tree use it

PASS, FAIL, SKIP = "pass", "fail", "skip"


def load_suites():
    """The table, from raye_tests_suites.py next to this script."""
    here = os.path.dirname(os.path.abspath(__file__))
    path = os.path.join(here, "raye_tests_suites.py")
    if not os.path.exists(path):
        raise SystemExit("raye-tests: %s is missing" % path)
    spec = importlib.util.spec_from_file_location("raye_tests_suites", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.MANIFEST


# ======================================================================
# requirements

_FONTS = None


def have_font(family):
    global _FONTS
    if _FONTS is None:
        if not shutil.which("fc-list"):
            _FONTS = set()
        else:
            out = subprocess.run(["fc-list", ":", "family"], capture_output=True,
                                 text=True).stdout
            _FONTS = {f.strip() for line in out.splitlines() for f in line.split(",")}
    return family in _FONTS


def missing(req, ctx):
    """The reason this requirement is not met, or None when it is."""
    kind, _, what = req.partition(":")
    if kind == "cmd":
        return None if shutil.which(what) else "%s is not installed" % what
    if kind == "font":
        return None if have_font(what) else "the font %s is not installed" % what
    if kind == "env":
        return None if os.environ.get(what) else "%s is not set" % what
    if kind == "py":
        try:
            __import__(what)
            return None
        except Exception:
            return "the Python module %s is missing" % what
    if kind == "dir":
        p = what if os.path.isabs(what) else os.path.join(ctx["repo"], what)
        return None if os.path.isdir(p) else "%s does not exist" % what
    if kind == "file":
        p = what if os.path.isabs(what) else os.path.join(ctx["repo"], what)
        return None if os.path.exists(p) else "%s does not exist" % what
    if kind == "ok":
        # The repository answers for itself. A requirement written in this
        # table is a fact typed in once, and it goes stale without a word
        # the day the repository moves it; a command re-asks every run, and
        # its own last line is the reason, so the remedy is named by the
        # side that knows it.
        try:
            p = subprocess.run(["sh", "-c", what], cwd=ctx["repo"], text=True,
                               capture_output=True, timeout=60,
                               stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as e:
            return "%s did not answer (%s)" % (what, e.__class__.__name__)
        if p.returncode == 0:
            return None
        said = [l for l in (p.stdout + p.stderr).splitlines() if l.strip()]
        return said[-1].strip() if said else "%s exited %d" % (what, p.returncode)
    if kind == "iso":
        return None if ctx.get("iso") else ctx.get("no_iso_why", "no ISO was given")
    if kind == "image":
        return None if ctx.get("image") else ctx.get("no_image_why", "no image tree")
    raise SystemExit("raye-tests: unknown requirement %r" % req)


# ======================================================================
# counting what ran

RE_PYTEST = re.compile(r"(?:^|\s)(\d+) (passed|failed|error|errors|skipped|xfailed|"
                       r"xpassed|deselected)\b")
RE_UNITTEST = re.compile(r"^Ran (\d+) tests?\b", re.M)
RE_OK = re.compile(r"^\s*ok\b", re.M)
RE_BAD = re.compile(r"^\s*(FAIL|fail|failed)\b", re.M)
# the three shapes the shell tests of this tree end with, measured 2026-11-06
RE_SUM = re.compile(r"(\d+)\s+(?:passed|checks?)\s*,\s*(\d+)\s+failed", re.I)
RE_ALLOK = re.compile(r"all checks passed", re.I)
# qmltestrunner ends with its own tally. It is read rather than folded
# into "shell" because that one has no place for "skipped", and a QML
# test that skips itself is exactly what the report exists to show.
RE_QMLTEST = re.compile(r"^Totals: (\d+) passed, (\d+) failed, (\d+) skipped",
                        re.M)
# ctest's own last lines. Both are read, and the SKIPPED one only when
# it is there: ctest prints it only if something skipped, and taking its
# absence for zero would be right by accident -- while reading only the
# percentage line would count a skipped test as a pass.
RE_CTEST = re.compile(r"^(\d+)% tests passed, (\d+) tests? failed out of (\d+)",
                      re.M)
RE_CTEST_SKIP = re.compile(r"^\s*Tests Skipped:\s*(\d+)", re.M)


def counts(how, out):
    """(ran, passed, failed, skipped) or None when nothing could be counted."""
    if how == "pytest":
        found = RE_PYTEST.findall(out)
        if not found:
            return None
        n = {k: 0 for k in ("passed", "failed", "error", "errors", "skipped",
                            "xfailed", "xpassed", "deselected")}
        for num, kind in found:
            n[kind] += int(num)
        bad = n["failed"] + n["error"] + n["errors"]
        good = n["passed"] + n["xpassed"] + n["xfailed"]
        return good + bad + n["skipped"], good, bad, n["skipped"]
    if how == "unittest":
        m = RE_UNITTEST.search(out)
        if not m:
            return None
        ran = int(m.group(1))
        fail = sum(int(x) for x in re.findall(r"(?:failures|errors)=(\d+)", out))
        skip = sum(int(x) for x in re.findall(r"skipped=(\d+)", out))
        return ran, ran - fail - skip, fail, skip
    if how == "qmltest":
        found = RE_QMLTEST.findall(out)
        if not found:
            return None
        # One tally per qmltestrunner process; a suite may run several.
        good = sum(int(g) for g, _, _ in found)
        bad = sum(int(f) for _, f, _ in found)
        skip = sum(int(k) for _, _, k in found)
        return good + bad + skip, good, bad, skip
    if how == "ctest":
        m = RE_CTEST.search(out)
        if not m:
            return None
        bad, total = int(m.group(2)), int(m.group(3))
        skipped = RE_CTEST_SKIP.search(out)
        skip = int(skipped.group(1)) if skipped else 0
        # "out of N" is what ctest SELECTED, so N already includes the
        # skipped ones; passed is what is left.
        return total, total - bad - skip, bad, skip
    if how == "shell":
        # "48 passed, 0 failed" / "65 checks, 0 failed" come first: they are
        # the script's own count, and it only prints them once it is done.
        m = RE_SUM.search(out)
        if m:
            good, bad = int(m.group(1)), int(m.group(2))
            return good + bad, good, bad, 0
        good, bad = len(RE_OK.findall(out)), len(RE_BAD.findall(out))
        if good + bad:
            return good + bad, good, bad, 0
        # a script that prints only its verdict still proves it got there
        if RE_ALLOK.search(out):
            return 1, 1, 0, 0
        return None
    return None


# ======================================================================
# the image

class Image:
    """The ISO opened read-only, with a writable overlay on top.

    The overlay is not a nicety. Measured 2026-11-06: against the bare
    read-only squashfs, tests/test_apt_sources.sh --root reports two
    FAILs because it cannot mktemp inside the tree -- a false red on a
    repository that is right. With the overlay the same run is green and
    fetches 16 source indexes, which is the verdict that was wanted.
    Nothing of it reaches the ISO: upperdir is thrown away.
    """

    def __init__(self, iso, work):
        self.iso, self.work, self.mounts, self.tree, self.why = iso, work, [], None, None

    def _mount(self, args, at):
        os.makedirs(at, exist_ok=True)
        r = subprocess.run(["mount"] + args + [at], capture_output=True, text=True)
        if r.returncode != 0:
            self.why = (r.stderr.strip() or "mount failed").splitlines()[-1]
            return False
        self.mounts.append(at)
        return True

    def open(self):
        if os.geteuid() != 0:
            self.why = "an ISO can only be opened as root"
            return False
        if not os.path.isfile(self.iso):
            self.why = "no such ISO: %s" % self.iso
            return False
        m1 = os.path.join(self.work, "iso")
        if not self._mount(["-o", "loop,ro", self.iso], m1):
            return False
        squash = None
        for root, _dirs, names in os.walk(m1):
            if "filesystem.squashfs" in names:
                squash = os.path.join(root, "filesystem.squashfs")
                break
        if not squash:
            self.why = "%s carries no filesystem.squashfs" % self.iso
            return False
        low = os.path.join(self.work, "squash")
        if not self._mount(["-t", "squashfs", "-o", "loop,ro", squash], low):
            return False
        up, wd = os.path.join(self.work, "up"), os.path.join(self.work, "ovlwork")
        os.makedirs(up, exist_ok=True)
        os.makedirs(wd, exist_ok=True)
        tree = os.path.join(self.work, "image")
        if not self._mount(["-t", "overlay", "overlay", "-o",
                            "lowerdir=%s,upperdir=%s,workdir=%s" % (low, up, wd)], tree):
            return False
        self.tree = tree
        return True

    @staticmethod
    def holders(at):
        """Which processes keep `at` busy, read from /proc rather than guessed.

        🚨 The old code printed "WARNING: ... is still mounted" and named
        nothing. Measured 2026-11-06: by the time anyone looked, NOTHING
        held it -- a subprocess had simply not finished dying when close()
        ran, and `umount` by hand worked at the first try. A warning that
        cannot say who is holding the mount sends the reader looking for a
        bug that is already gone.
        """
        found = []
        for d in glob.glob("/proc/[0-9]*"):
            pid = os.path.basename(d)
            where = []
            for what in ("root", "cwd"):
                try:
                    link = os.readlink(os.path.join(d, what))
                except OSError:
                    continue
                if link.startswith(at):
                    where.append(what)
            if not where:
                try:
                    for fd in os.listdir(os.path.join(d, "fd")):
                        try:
                            link = os.readlink(os.path.join(d, "fd", fd))
                        except OSError:
                            continue
                        if link.startswith(at):
                            where.append("fd " + fd)
                            break
                except OSError:
                    pass
            if where:
                try:
                    with open(os.path.join(d, "cmdline"), "rb") as fh:
                        cmd = fh.read().replace(b"\0", b" ").decode(
                            "utf-8", "replace").strip()
                except OSError:
                    cmd = "?"
                found.append("pid %s (%s) %s" % (pid, ", ".join(where), cmd[:60]))
        return found

    def close(self, tries=8):
        """Release the mounts, outermost first. Returns the ones left over.

        ⚠️ It STOPS at the first mount it cannot release, and that is the
        correction that matters. The old loop carried on down the stack:
        with the overlay still live it went and unmounted the squashfs
        underneath it -- the overlay's own lowerdir -- which leaves a tree
        whose floor has been taken away and a loop device nothing can free,
        because the squashfs file it holds open lives on the ISO mount that
        is now pinned too. One busy mount became three.
        """
        left = []
        for at in reversed(self.mounts):
            if left:
                # Everything below a mount we could not release stays: see
                # the docstring. Naming it is the point; silence is not.
                left.append(at)
                continue
            for attempt in range(tries):
                if subprocess.run(["umount", at], capture_output=True).returncode == 0:
                    break
                time.sleep(0.5 * (attempt + 1))   # 18 s over 8 tries, not 6
            else:
                who = self.holders(at)
                print("raye-tests: WARNING: %s is still mounted" % at,
                      file=sys.stderr)
                for line in who or ["nothing holds it any more: a subprocess "
                                    "was still exiting when the run ended"]:
                    print("raye-tests:          %s" % line, file=sys.stderr)
                left.append(at)
        self.mounts = [at for at in self.mounts if at in left]
        return left


