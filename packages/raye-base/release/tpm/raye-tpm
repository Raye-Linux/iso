BOOT_ID = "/proc/sys/kernel/random/boot_id"

PCR = 7
# a binding that has not opened the disk for this many boots, and that
# no installed kernel can open, is removed
PRUNE_AFTER_BOOTS = 3
# a suspension that could not be resumed is dropped after this many
# starts anyway: the disk then asks its password, it is never left open
SUSPEND_MAX_BOOTS = 2
# present while a disk is suspended; raye-tpm-check.service only runs then
SUSPENDED_FLAG = "suspended"
# clevis' own reading of a binding, without the KDF check (its library
