#!/bin/sh
# Once, when the AMD RGBA8888 fix comes in: a PC the graphics ladder left
# on a fallback level (09_raye_graphics: amdgpu.dc=0, or nomodeset at
# 800x600 without acceleration) goes back to the normal level, if its card
# is one the fix covers (raye-amd-cursor --covered). Many of those black
# screens were that bug. If the screen still stays black, the ladder steps
# down again by itself after two starts.
#
# raye-graphics-retry --driver: the same, at once and as often as asked,
# for any card, when a graphics driver came in or changed
# (raye-gpu-driver-changed, raye-drivers). The fallback level was chosen
# while the old driver left the screen black; the new one must get its
# chance, or a PC with a working NVIDIA driver stays at nomodeset (no
# acceleration, a few frames per second in games) for good.
#
# raye-graphics-retry --no-amd: once, on a PC with no AMD display device,
# level 1 goes back to level 0. Up to 1.0 Beta the ladder took two starts
# that only reached the sign-in screen (an update restart at night, its own
# second start) for a black screen, and left such PCs on level 1 for good:
# no boot screen, an update screen in plain text. amdgpu.dc=0 does nothing
# on another card, so level 1 there only took the boot screen away. Level 2
# (nomodeset, reached by two more black starts) is kept.
#
# Only the ladder's own level is touched: nomodeset or amdgpu.dc= written
# by the user in /etc/default/grub or grub.d stays as it is. Run by
# raye-system's postinst; the mark makes sure it never runs twice.
set -u
ENV=${RAYE_GRUBENV:-/boot/grub/grubenv}
MARK=${RAYE_GFX_RETRY_MARK:-/var/lib/raye-system/gfx-retry-rgba8888}
DEFAULTS=${RAYE_GRUB_DEFAULTS:-/etc/default}
AMD_CURSOR=${RAYE_AMD_CURSOR:-/usr/libexec/raye-amd-cursor}

driver= no_amd=
[ "${1-}" = --driver ] && driver=yes
[ "${1-}" = --no-amd ] && no_amd=yes
[ -n "$no_amd" ] && MARK=${RAYE_GFX_LEVEL1_MARK:-/var/lib/raye-system/gfx-retry-level1-no-amd}
if [ -n "$driver" ]; then
    done_once() { exit 0; }
else
    [ -e "$MARK" ] && exit 0
    done_once() { mkdir -p "${MARK%/*}" && : > "$MARK"; exit 0; }
fi

fs=$(${grub_probe:-grub-probe} --target=fs "${RAYE_BOOT_DIR:-/boot}" 2>/dev/null || true)
case $fs in
ext2|ext3|ext4|fat) ;;
*) done_once ;;
esac
[ -e "$ENV" ] || done_once

level=$(grub-editenv "$ENV" list 2>/dev/null | sed -n 's/^raye_gfx_level=//p')
case $level in
1 | 2) ;;
*) done_once ;;
esac
[ -n "$no_amd" ] && [ "$level" != 1 ] && done_once

if cat "$DEFAULTS/grub" "$DEFAULTS"/grub.d/*.cfg 2>/dev/null |
        grep -v '^[[:space:]]*#' |
        grep -q -E '(^|[^[:alnum:]_.])(nomodeset([^[:alnum:]_.]|$)|amdgpu\.dc=)'; then
    done_once
fi

# an AMD display device (vendor 0x1002, class 0x03xxxx) keeps level 1:
# amdgpu.dc=0 may be what lets it show a picture
amd_display() {
    for dev in "${RAYE_SYS:-/sys}"/bus/pci/devices/*; do
        [ -r "$dev/vendor" ] && [ -r "$dev/class" ] || continue
        read -r vendor < "$dev/vendor" || continue
        read -r class < "$dev/class" || continue
        [ "$vendor" = 0x1002 ] || continue
        case $class in 0x03*) return 0 ;; esac
    done
    return 1
}
if [ -n "$no_amd" ]; then
    amd_display && done_once
elif [ -z "$driver" ]; then
    "$AMD_CURSOR" --covered || done_once
fi

# a failed write leaves no mark: the next upgrade tries again
grub-editenv "$ENV" set raye_gfx_level=0 raye_gfx_fails=0 || exit 0
done_once
