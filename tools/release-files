#!/usr/bin/python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Prepares the files of a release from a built ISO.

    release-files                       $ISO, into $STAGE/release/$RELEASE
    release-files --dry-run             say what would be written
    release-files --iso FILE --out DIR [--no-sign]

Writes, next to each other:
    SHA256SUMS, SHA256SUMS.asc   checksums of the ISO and of its parts, signed
    raye-archive.asc             the public key that signed them
    release-notes-<release>.md, release-notes-<release>.fr.md
    release.json                 name, size, checksum, addresses (the download page reads it)
    parts/                       the ISO cut under GitHub's 2 GiB limit per file

The ISO itself is not copied: publish-r2 uploads it from where it is,
under the name raye-<release>-amd64.iso.
"""
from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import pathlib
import shutil
import sys

sys.dont_write_bytecode = True  # no __pycache__ in the repo
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import raye_publish as rp  # noqa: E402

PART_SIZE = 1900 * 1024 * 1024
DOCS = rp.HERE.parent / "docs"


def iso_name(conf):
    return f"raye-{conf['RELEASE']}-amd64.iso"


def notes_of(conf):
    """English first: GitHub shows the first one on the release page."""
    return [DOCS / f"release-notes-{conf['RELEASE']}{lang}.md" for lang in ("", ".fr")]


def urls(conf):
    gh = f"https://github.com/{conf['GITHUB_ORG']}/{conf['GITHUB_RELEASES']}"
    return {
        "r2": f"{conf['R2_PUBLIC']}/iso/{conf['RELEASE']}/{iso_name(conf)}",
        "r2_folder": f"{conf['R2_PUBLIC']}/iso/{conf['RELEASE']}/",
        "github": f"{gh}/releases/tag/v{conf['RELEASE']}",
        "github_download": f"{gh}/releases/download/v{conf['RELEASE']}/",
        "issues": f"{gh}/issues",
    }


def split(iso, folder, name, part_size=None):
    """Cuts the ISO into name.part1, name.part2... in one read.

    Returns (sha256 of the whole ISO, [(part name, size, sha256)]).
    """
    part_size = part_size or PART_SIZE
    folder.mkdir(parents=True, exist_ok=True)
    whole, parts = hashlib.sha256(), []
    with open(iso, "rb") as src:
        n = 0
        while True:
            n += 1
            part = folder / f"{name}.part{n}"
            h, size = hashlib.sha256(), 0
            with open(part, "wb") as dst:
                while size < part_size:
                    block = src.read(min(8 << 20, part_size - size))
                    if not block:
                        break
                    whole.update(block)
                    h.update(block)
                    dst.write(block)
                    size += len(block)
            if size == 0:
                part.unlink()
                break
            parts.append((part.name, size, h.hexdigest()))
            if size < part_size:
                break
    return whole.hexdigest(), parts


def write(conf, iso, out, signed=True, keyring=rp.KEYRING):
    name = iso_name(conf)
    tmp = out.with_name(out.name + ".new")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    digest, parts = split(iso, tmp / "parts", name)
    size = iso.stat().st_size
    lines = [f"{digest}  {name}"] + [f"{h}  {p}" for p, _, h in parts]
    (tmp / "SHA256SUMS").write_text("\n".join(lines) + "\n")
    shutil.copy2(rp.KEYRING.with_name("raye-archive.asc"), tmp / "raye-archive.asc")
    for src in notes_of(conf):
        if not src.is_file():
            raise rp.PublishError(f"missing {src}")
        shutil.copy2(src, tmp / src.name)
    info = {
        "release": conf["RELEASE"],
        "title": conf["RELEASE_TITLE"],
        "date": datetime.date.fromtimestamp(iso.stat().st_mtime).isoformat(),
        "iso": name,
        "size": size,
        "sha256": digest,
        "parts": [{"name": p, "size": s, "sha256": h} for p, s, h in parts],
        "key": conf["SIGNING_KEY"],
        "source": str(iso),
        "urls": urls(conf),
    }
    (tmp / "release.json").write_text(json.dumps(info, indent=2) + "\n")
    if signed:
        rp.sign_detached(conf, tmp / "SHA256SUMS", tmp / "SHA256SUMS.asc")
        if not rp.verify(keyring, tmp / "SHA256SUMS.asc", tmp / "SHA256SUMS"):
            raise rp.PublishError(f"SHA256SUMS.asc does not verify with {keyring}")
    shutil.rmtree(out, ignore_errors=True)
    tmp.rename(out)
    return info


def main(argv=None):
    conf = rp.settings()
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--iso", default=conf["ISO"])
    ap.add_argument("--out", default=os.path.join(conf["STAGE"], "release", conf["RELEASE"]))
    ap.add_argument("--dry-run", action="store_true", help="say what would be written")
    ap.add_argument("--no-sign", action="store_true", help="for a test only")
    args = ap.parse_args(argv)
    iso, out = pathlib.Path(args.iso).resolve(), pathlib.Path(args.out)
    try:
        if not iso.is_file():
            raise rp.PublishError(f"no ISO at {args.iso}")
        size = iso.stat().st_size
        count = -(-size // PART_SIZE)
        print(f"{iso} ({rp.human(size)})")
        print(f"  -> {out}/: SHA256SUMS{'' if args.no_sign else ', SHA256SUMS.asc'}, "
              f"raye-archive.asc, release notes, release.json, parts/ ({count} parts)")
        print(f"  published as {iso_name(conf)}; {urls(conf)['r2']}")
        if args.dry_run:
            return 0
        if not args.no_sign and not rp.have_key(conf):
            raise rp.PublishError(f"no signing key {conf['SIGNING_KEY']} in {conf['GNUPGHOME']}")
        info = write(conf, iso, out, signed=not args.no_sign)
    except (rp.PublishError, OSError) as e:
        print(f"release-files: {e}", file=sys.stderr)
        return 1
    print(f"sha256 {info['sha256']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
