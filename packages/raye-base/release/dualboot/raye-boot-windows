#!/bin/sh
# Makes the next start, and only the next one, go straight to Windows,
# without the boot menu. Run through pkexec by raye-restart-to-windows.
#
#   raye-boot-windows --check   print the Windows entry, exit 1 if none
#   raye-boot-windows           set it as BootNext
#
# A firmware boot entry is not proof that Windows is still there: when
# Windows was erased to install Raye, its entry often stays in the firmware.
# An entry only counts if the partition it points to still exists and, when
# that partition is mounted, still holds Windows' boot loader.
set -u
EFIBOOTMGR=${EFIBOOTMGR:-efibootmgr}
BY_PARTUUID=${BY_PARTUUID:-/dev/disk/by-partuuid}
FINDMNT=${FINDMNT:-findmnt}

# entries that look like Windows: by name, or by Windows' own loader
candidates=$("$EFIBOOTMGR" -v 2>/dev/null |
    grep -i -E '^Boot[0-9A-F]{4}\*? Windows Boot Manager|bootmgfw\.efi' |
    sed -n 's/^Boot\([0-9A-F]\{4\}\).*/\1/p')

still_there() {
    line=$("$EFIBOOTMGR" -v 2>/dev/null | grep "^Boot$1")
    uuid=$(printf '%s\n' "$line" | sed -n 's/.*HD([0-9]*,GPT,\([0-9A-Fa-f-]*\),.*/\1/p' | tr 'A-F' 'a-f')
    # no partition named (some firmware): trust the entry
    [ -n "$uuid" ] || return 0
    [ -e "$BY_PARTUUID/$uuid" ] || return 1
    mnt=$("$FINDMNT" -n -o TARGET -S "PARTUUID=$uuid" 2>/dev/null | head -n 1)
    # partition not mounted: it exists, that is all we can tell
    [ -n "$mnt" ] || return 0
    # vfat lookups ignore case
    [ -e "$mnt/EFI/Microsoft/Boot/bootmgfw.efi" ]
}

entry=
for e in $candidates; do
    if still_there "$e"; then
        entry=$e
        break
    fi
done

[ -n "$entry" ] || { echo "no Windows boot entry" >&2; exit 1; }
if [ "${1:-}" = --check ]; then
    echo "$entry"
    exit 0
fi
exec "$EFIBOOTMGR" -q -n "$entry"
