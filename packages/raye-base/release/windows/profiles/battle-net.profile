# Battle.net: Vulkan translation for the games, Microsoft fonts for the app.
# A launcher: the games it starts get Game Mode, the app itself does not.
name="Battle.net"
match="*battle.net-setup* *battlenet*"
verbs="corefonts dxvk"
game="launcher"
launcher="Battle.net.exe;Agent.exe;Battle.net Helper.exe;BlizzardError.exe;Battle.net Launcher.exe;Battle.net-Setup.exe;Battle.net Uninstaller.exe"
