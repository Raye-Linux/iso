#!/bin/sh
# Hands every game that starts to GameMode, which then runs the PC for
# the game until it ends (gamemode.ini, raye-game-start). GameMode itself
# notices a game that ends or crashes within 5 seconds.
#
# What counts as a game:
#   Steam      the "reaper SteamLaunch AppId=N" process Steam runs each
#              game under, Flatpak or not
#   the Store  a running Flatpak whose Start entry is in the Game category,
#              except the launchers (their games are found on their own)
#   Windows    the programs of a space raye-run-windows marks as a game
#              (its profile, or Settings), not the layer's own services
#              nor, for a launcher, the launcher itself
#   Roblox     the player Quadra starts under Rosemary ("<rosemary>
#              .../RobloxPlayer.app"), from the Store's AppImage or Flatpak;
#              Quadra itself is a launcher
# The person's choices are in ~/.config/raye/game-mode.conf (game-mode.sh).
# Games are listed for Settings in ~/.local/state/raye/game-mode/games.
#
#   raye-game-watch           runs until the session ends
#   raye-game-watch --once    looks once (tests)
#
# Every two seconds it reads a few small files. /proc is searched only
# while Steam runs (for its games) or while a Windows program marked by
# raye-run-windows runs: a grep over every process costs about 10 ms.
set -u
. "${RAYE_GAME_LIB:-/usr/lib/raye/gaming/game-mode.sh}"
exports=${RAYE_GAME_FLATPAK_EXPORTS:-"$HOME/.local/share/flatpak/exports/share/applications /var/lib/flatpak/exports/share/applications"}
steampids=${RAYE_GAME_STEAM_PIDFILES:-"$HOME/.steam/steam.pid"}
steamlibs=${RAYE_GAME_STEAM_LIBS:-"$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps $HOME/.local/share/Steam/steamapps $HOME/.steam/steam/steamapps"}
# the Common Redistributables Steam installs before a game's first start
steam_tools=" 228980 "
launchers=" com.valvesoftware.Steam com.heroicgameslauncher.hgl net.lutris.Lutris com.usebottles.bottles io.itch.itch org.quadrahq.Quadra "
nl='
'
me=$$
gm=com.feralinteractive.GameMode
# "pid|key|kind" handed over, kept in a file so a restart knows them
mine="" known="" instances="" sandboxes="" last=-
mkdir -p "$runtime"
[ -r "$runtime/watch" ] && read -r mine < "$runtime/watch"

save() { printf '%s\n' "$mine" > "$runtime/watch.new" && mv "$runtime/watch.new" "$runtime/watch"; }

wanted() { # key kind
    [ "$enabled" = true ] || return 1
    listed "$off" "$1" && return 1
    case $1 in
        windows:*) case $2 in yes|launcher) return 0 ;; esac
                   listed "$on" "$1" ;;
    esac
}

# Settings lists the games played here, the last one played at the end
remember() { # key name
    f=$statedir/games
    mkdir -p "$statedir" || return 0
    { grep -v "^$1	" "$f" 2>/dev/null | tail -n 39; printf '%s\t%s\n' "$1" "$2"; } > "$f.new" &&
        mv "$f.new" "$f"
}

handover() { # pid key kind name
    r=$("$busctl" --user --timeout=3 call $gm /com/feralinteractive/GameMode $gm RegisterGameByPID ii "$me" "$1" 2>/dev/null)
    # GameMode not there yet: the process is looked at again next time
    [ "$r" = "i 0" ] || return 1
    mine="$mine $1|$2|$3"
    save
    remember "$2" "$4"
}

giveback() { # pid
    "$busctl" --user --timeout=3 call $gm /com/feralinteractive/GameMode $gm UnregisterGameByPID ii "$me" "$1" >/dev/null 2>&1
}

mine_has() { case " $mine " in *" $1|"*) return 0 ;; esac; return 1; }
look() { known="$known $1"; }
args_of() { { tr '\0' '\n' < "$proc/$1/cmdline"; } 2>/dev/null; }

# the file is read every time (a few lines, no program started): a change
# made in Settings while a game runs counts at once
reread() {
    read_conf
    choices="$enabled $off / $on"
    [ "$choices" = "$last" ] && return 0
    last=$choices
    # what is no longer wanted goes back to GameMode now
    keep=""
    for e in $mine; do
        pid=${e%%|*} rest=${e#*|}
        if wanted "${rest%|*}" "${rest#*|}"; then keep="$keep $e"; else giveback "$pid"; fi
    done
    [ "$keep" = "$mine" ] || { mine=$keep; save; }
    known=""
}

tidy() {
    keep=""
    for e in $mine; do [ -d "$proc/${e%%|*}" ] && keep="$keep $e"; done
    [ "$keep" = "$mine" ] || { mine=$keep; save; }
    keep=""
    for p in $known; do [ -d "$proc/$p" ] && keep="$keep $p"; done
    known=$keep
}

steam_runs() {
    alive=""
    for p in $sandboxes; do [ -d "$proc/$p" ] && alive="$alive $p"; done
    sandboxes=$alive
    [ -n "$sandboxes" ] && return 0
    for f in $steampids; do
        p=""
        { read -r p < "$f"; } 2>/dev/null
        case $p in ''|*[!0-9]*) ;; *) [ -d "$proc/$p" ] && return 0 ;; esac
    done
    return 1
}

steam() {
    steam_runs || return 0
    for f in $(grep -lsa SteamLaunch "$proc"/[0-9]*/cmdline); do
        pid=${f%/cmdline}; pid=${pid##*/}
        listed "$known" "$pid" && continue
        mine_has "$pid" && continue
        look "$pid"
        a=$(args_of "$pid") id=""
        case ${a%%"$nl"*} in reaper|*/reaper) ;; *) continue ;; esac
        set -f; ifs=$IFS; IFS=$nl
        for w in $a; do case $w in AppId=*) id=${w#AppId=} ;; esac; done
        IFS=$ifs; set +f
        case $id in ''|0|*[!0-9]*) continue ;; esac
        listed "$steam_tools" "$id" && continue
        wanted "steam:$id" "" || continue
        name=""
        for lib in $steamlibs; do
            [ -r "$lib/appmanifest_$id.acf" ] || continue
            name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$lib/appmanifest_$id.acf" | head -n 1)
            break
        done
        handover "$pid" "steam:$id" "" "$name" || known=${known% "$pid"}
    done
}

store() {
    keep=""
    for d in "$xrt"/.flatpak/*/; do
        [ -d "$d" ] || continue
        i=${d%/}; i=${i##*/}
        if listed "$instances" "$i"; then keep="$keep $i"; continue; fi
        app="" group=""
        while IFS= read -r line; do
            case $line in
                \[*) group=$line ;;
                name=*) [ "$group" = "[Application]" ] && [ -z "$app" ] && app=${line#name=} ;;
            esac
        done < "$d/info" 2>/dev/null
        # still starting: bwrap writes its pid a moment later
        pid=$(sed -n 's/.*"child-pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$d/bwrapinfo.json" 2>/dev/null)
        [ -n "$app" ] && [ -n "$pid" ] || continue
        keep="$keep $i"
        [ -d "$proc/$pid" ] || continue
        # Steam from the Store: its pid file holds a pid of its sandbox
        [ "$app" = com.valvesoftware.Steam ] && sandboxes="$sandboxes $pid"
        listed "$launchers" "$app" && continue
        name="" game=""
        for e in $exports; do
            [ -r "$e/$app.desktop" ] || continue
            group=""
            while IFS= read -r line; do
                case $line in
                    \[*) group=$line ;;
                    Name=*) [ "$group" = "[Desktop Entry]" ] && [ -z "$name" ] && name=${line#Name=} ;;
                    Categories=*) [ "$group" = "[Desktop Entry]" ] &&
                        case ";${line#Categories=}" in *";Game;"*) game=1 ;; esac ;;
                esac
            done < "$e/$app.desktop"
            break
        done
        [ -n "$game" ] && wanted "app:$app" "" || continue
        handover "$pid" "app:$app" "" "$name" || keep=${keep% "$i"}
    done
    instances=$keep
}

# Roblox through Quadra. Looked for only while an AppImage is mounted (the
# Store's Quadra is one) or Quadra's Flatpak runs: a grep over every
# process costs about 10 ms.
natives() {
    grep -qs '/\.mount_' "$proc/mounts" ||
        grep -qsx 'name=org.quadrahq.Quadra' "$xrt"/.flatpak/*/info || return 0
    for f in $(grep -lsa 'RobloxPlayer\.app' "$proc"/[0-9]*/cmdline); do
        pid=${f%/cmdline}; pid=${pid##*/}
        listed "$known" "$pid" && continue
        mine_has "$pid" && continue
        look "$pid"
        a=$(args_of "$pid") found=""
        set -f; ifs=$IFS; IFS=$nl
        for w in $a; do
            case $w in */RobloxPlayer.app|*/RobloxPlayer.app/) found=1 ;; esac
        done
        IFS=$ifs; set +f
        [ -n "$found" ] || continue
        wanted "app:com.roblox.RobloxPlayer" "" || continue
        handover "$pid" "app:com.roblox.RobloxPlayer" "" "Roblox" || known=${known% "$pid"}
    done
}

# raye-run-windows leaves $runtime/windows/PID for each program it starts;
# the search goes on a minute after that process ends, for a launcher that
# starts its game and quits
windows_runs() {
    found=""
    for m in "$runtime"/windows/*; do
        [ -e "$m" ] || continue
        if [ -d "$proc/${m##*/}" ]; then
            found=1
        elif [ -n "$(find "$m" -mmin +1 2>/dev/null)" ]; then
            rm -f "$m"
        else
            found=1
        fi
    done
    [ -n "$found" ]
}

windows() {
    windows_runs || return 0
    for f in $(grep -lsa RAYE_GAME_SPACE= "$proc"/[0-9]*/environ); do
        pid=${f%/environ}; pid=${pid##*/}
        listed "$known" "$pid" && continue
        mine_has "$pid" && continue
        a=$(args_of "$pid")
        exe=$(printf '%s' "${a%%"$nl"*}" | tr 'A-Z' 'a-z')
        case $exe in
            *.exe) ;;
            # the runner and the loader become the program in a moment
            sh|*/sh|dash|*/dash|wine|*/wine|wine64|*/wine64|*-preloader) continue ;;
            *) look "$pid"; continue ;;
        esac
        look "$pid"
        case $exe in *'\windows\'*) continue ;; esac
        exe=${exe##*\\}
        space="" kind="" name="" ignore=""
        e=$({ tr '\0' '\n' < "$f"; } 2>/dev/null)
        set -f; ifs=$IFS; IFS=$nl
        for w in $e; do
            case $w in
                RAYE_GAME_SPACE=*) space=${w#*=} ;;
                RAYE_GAME_KIND=*) kind=${w#*=} ;;
                RAYE_GAME_NAME=*) name=${w#*=} ;;
                RAYE_GAME_IGNORE=*) ignore=${w#*=} ;;
            esac
        done
        IFS=$ifs; set +f
        case $space in ''|*[!a-z0-9-]*) continue ;; esac
        case ";$ignore;" in *";$exe;"*) continue ;; esac
        wanted "windows:$space" "$kind" || continue
        handover "$pid" "windows:$space" "$kind" "$name" || known=${known% "$pid"}
    done
}

once() {
    reread
    tidy
    [ "$enabled" = true ] || return 0
    store
    steam
    windows
    natives
}

if [ "${1:-}" = --once ]; then
    once
    exit 0
fi
# a session that ended in the middle of a game can leave the game
# scheduler running: it has nothing to do with this one
if ! "$systemctl" --user -q is-active raye-game-mode.service 2>/dev/null &&
   "$systemctl" -q is-active raye-game-scheduler.service 2>/dev/null; then
    "$systemctl" --no-ask-password stop raye-game-scheduler.service 2>/dev/null
fi
while :; do
    once
    sleep "${RAYE_GAME_INTERVAL:-2}"
done
