UNSEAL_SLOT = ('command -v clevis-luks-common-functions >/dev/null || exit 127\n'
               '. clevis-luks-common-functions\n'
               'command -v clevis_luks_unlock_device_by_slot >/dev/null || exit 127\n'
               'clevis_luks_unlock_device_by_slot "$1" "$2" YES\n')

EXIT_OK, EXIT_ERROR, EXIT_REFUSED, EXIT_NOTHING, EXIT_FAILED = 0, 1, 2, 3, 4

EV_NO_ACTION = 0x00000003
EV_SEPARATOR = 0x00000004
EV_EFI_VARIABLE_DRIVER_CONFIG = 0x80000001
EV_EFI_VARIABLE_AUTHORITY = 0x800000E0

# TPM algorithm id -> (name, digest size)
ALGORITHMS = {
    0x0004: ("sha1", 20),
    0x000B: ("sha256", 32),
    0x000C: ("sha384", 48),
    0x000D: ("sha512", 64),
    0x0012: ("sm3_256", 32),
}
