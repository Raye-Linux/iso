// Security fixes go in on their own until Raye Update takes over.
//
// The stock file names its origins with ${distro_id}, which is "Raye"
// here and would match nothing, so the lists are cleared and written out
// by hand. Firefox comes from Mozilla's archive and always counts as an
// update to take.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "origin=Ubuntu,archive=resolute-security,label=Ubuntu";
    "site=packages.mozilla.org";
};
// What Raye Update only installs at a restart: the kernel and boot chain,
// drivers, libc, systemd, Qt, KDE, Plasma and Mesa. New files under a
// running desktop crash it, so these wait for Raye Update even when they
// are security fixes. Same list as OFFLINE_PACKAGES in raye-update, then
// the binaries of its OFFLINE_SOURCES; each line is a Python regex matched
// at the start of the package name.
Unattended-Upgrade::Package-Blacklist {
