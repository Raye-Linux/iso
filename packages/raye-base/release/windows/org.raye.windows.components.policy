<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Raye Linux</vendor>
  <action id="org.raye.windows.components">
    <description>Add or remove Windows compatibility components</description>
    <description xml:lang="fr">Ajouter ou supprimer les composants de compatibilité Windows</description>
    <description xml:lang="es">Agregar o quitar componentes de compatibilidad con Windows</description>
    <description xml:lang="de">Windows-Kompatibilitätskomponenten hinzufügen oder entfernen</description>
    <description xml:lang="pt_BR">Adicionar ou remover componentes de compatibilidade com o Windows</description>
    <description xml:lang="it">Aggiungi o rimuovi componenti di compatibilità con Windows</description>
    <message>Changing Windows compatibility components needs your permission</message>
    <message xml:lang="fr">Modifier les composants de compatibilité Windows demande votre autorisation</message>
    <message xml:lang="es">Para cambiar los componentes de compatibilidad con Windows se necesita tu permiso</message>
    <message xml:lang="de">Zum Ändern der Windows-Kompatibilitätskomponenten ist Ihre Erlaubnis erforderlich</message>
    <message xml:lang="pt_BR">Alterar os componentes de compatibilidade com o Windows exige sua permissão</message>
    <message xml:lang="it">Per cambiare i componenti di compatibilità con Windows serve la tua autorizzazione</message>
    <!-- it installs software for everyone: a sudo user says yes -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/raye-windows-components</annotate>
  </action>
</policyconfig>
