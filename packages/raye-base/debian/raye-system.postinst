#!/bin/sh
set -e

# filled in at build time, see raye-system.preinst
DIVERT="#RAYE_DIVERT#"
# "yes" once the Raye Windows boot entry (30_raye_windows) ships
WINDOWS_ENTRY="#RAYE_WINDOWS_ENTRY#"

OS_PROBER=/etc/grub.d/30_os-prober
# set when this package is the one that turned os-prober's entry off
OS_PROBER_OFF=/var/lib/raye-system/os-prober-off
# set once Ubuntu's upgrade guard was made to start with each upgrade run
GUARD_ON_DEMAND=/var/lib/raye-system/upgrade-guard-on-demand

if [ "$1" = configure ]; then
    # netplan refuses to read a config other users can see
    chmod 600 "$DPKG_ROOT/etc/netplan/01-network-manager-all.yaml"

    # unattended-upgrade-shutdown waits in memory all day for a shutdown
    # during an upgrade run; apt-daily-upgrade.service now starts it for
    # each run. Done once, so someone who enables it again keeps it.
    if [ ! -e "$DPKG_ROOT$GUARD_ON_DEMAND" ] && command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper disable unattended-upgrades.service >/dev/null || true
        mkdir -p "$DPKG_ROOT${GUARD_ON_DEMAND%/*}"
        : > "$DPKG_ROOT$GUARD_ON_DEMAND"
    fi

    # older installs name one server per line in ubuntu.sources
    if [ -x "$DPKG_ROOT/usr/libexec/raye-ubuntu-mirrors" ]; then
        "$DPKG_ROOT/usr/libexec/raye-ubuntu-mirrors"
    fi

    # A file this version no longer replaces gets its stock one back.
    # --list does not filter by package: keep the lines that end in ours
    dpkg-divert --list | while read -r kind _ file _ to _ owner; do
        [ "$kind" = diversion ] && [ "$owner" = raye-system ] || continue
        case " $DIVERT " in
            *" $file "*) continue ;;
        esac
        dpkg-divert --package raye-system --remove --rename --divert "$to" "$file"
    done

    # The Raye entry finds Windows itself and names it plainly; the stock
    # os-prober script would add a second, longer one. update-grub skips
    # scripts that are not executable, and a statoverride survives grub
    # updates.
    if [ -n "$WINDOWS_ENTRY" ]; then
        if ! dpkg-statoverride --list "$OS_PROBER" >/dev/null 2>&1; then
            # --update sets the mode now; without the file there is nothing to set
            update=
            if [ -e "$DPKG_ROOT$OS_PROBER" ]; then
                update=--update
            fi
            dpkg-statoverride $update --add root root 0644 "$OS_PROBER"
            mkdir -p "$DPKG_ROOT${OS_PROBER_OFF%/*}"
            : > "$DPKG_ROOT$OS_PROBER_OFF"
        fi
    elif [ -e "$DPKG_ROOT$OS_PROBER_OFF" ]; then
        dpkg-statoverride --remove "$OS_PROBER" >/dev/null 2>&1 || true
        if [ -e "$DPKG_ROOT$OS_PROBER" ]; then
            chmod 755 "$DPKG_ROOT$OS_PROBER"
        fi
        rm -f "$DPKG_ROOT$OS_PROBER_OFF"
    fi

    # The kernel command line of 50-raye.cfg (no text on screen), the
    # boot picture and the safe graphics entry only reach the boot menu
    # through update-grub. Run it when one of them changed since the menu
    # was last written, not on every upgrade.
    stamp="$DPKG_ROOT/var/lib/raye-system/grub-cfg.sum"
    cfg="$DPKG_ROOT/etc/default/grub.d/50-raye.cfg"
    picture="$DPKG_ROOT/etc/grub.d/05_raye_boot_picture"
    safe="$DPKG_ROOT/etc/grub.d/11_raye_safe_graphics"
    if [ -z "$DPKG_ROOT" ] && [ -e /boot/grub/grub.cfg ] && [ -x /usr/sbin/update-grub ] \
        && [ -r "$cfg" ]; then
        # The menu keeps "Advanced options"; it must open on its first line.
        # 0.5.11 to 0.5.13 moved the kernels out of the submenu: undo that.
        sed -i '/^GRUB_DISABLE_SUBMENU=y$/d' /etc/default/grub.d/60-raye-kernel.cfg 2>/dev/null || true
        # A Raye kernel kept as the default by its own entry (inside the submenu,
        # "submenu>entry", or moved out by 0.5.13)
        # opened the menu there: the first line starts the newest kernel, so
        # when that is the Raye one it becomes the default. Never during the
        # one trial boot of a new Raye kernel.
        saved=$(grub-editenv - list 2>/dev/null | sed -n 's/^saved_entry=//p')
        newest=$(ls /boot/vmlinuz-* 2>/dev/null | sed 's|.*/vmlinuz-||' | sort -V | tail -n 1)
        case $saved in
        *-raye-*)
            if [ ! -e /var/lib/raye-kernel/trial ] && [ "${newest%-raye}" != "$newest" ]; then
                grub-set-default 0 || true
            fi ;;
        esac
        # An install made in Safe graphics kept nomodeset for good (800x600, no
        # acceleration). The graphics ladder (09_raye_graphics) replaces it: the
        # next start tries amdgpu.dc=0, and goes back to nomodeset by itself
        # after two starts that do not reach the desktop.
        if [ -e /etc/default/grub.d/90-raye-safe-graphics.cfg ]; then
            rm -f /etc/default/grub.d/90-raye-safe-graphics.cfg
            grub-editenv /boot/grub/grubenv set raye_gfx_level=1 raye_gfx_fails=0 2>/dev/null || true
        fi
        # once, with the AMD RGBA8888 fix: an AMD PC the ladder left on a
        # fallback level tries the normal one again
        /usr/libexec/raye-graphics-retry || true
        sum=$(cat "$cfg" "$picture" "$safe" "$DPKG_ROOT/etc/grub.d/09_raye_graphics" \
            "$DPKG_ROOT/etc/grub.d/31_raye_menu_wait" 2>/dev/null | md5sum)
        if [ "$sum" != "$(cat "$stamp" 2>/dev/null)" ] && update-grub; then
            mkdir -p "${stamp%/*}"
            echo "$sum" > "$stamp"
        fi
    fi
fi

# a PC that got the NVIDIA driver before the NVIDIA Control Panel was asked
# for: raye-drivers installs the panel at the next start
if [ "$1" = configure ] &&
   dpkg-query -W -f='${db:Status-Status} ${Package}\n' 'nvidia-driver-*' 2>/dev/null | grep -q '^installed ' &&
   ! dpkg-query -W -f='${db:Status-Status}' nvidia-settings 2>/dev/null | grep -q '^installed'; then
    mkdir -p /var/lib/raye && touch /var/lib/raye/drivers-nvidia-panel
fi

#DEBHELPER#

exit 0
