# report

def tail(text, n=25):
    lines = [l for l in text.splitlines() if l.strip()]
    return "\n".join("      | " + l for l in lines[-n:]) or "      | (no output)"


def excerpt(text):
    """What failed, then the end of the run.

    The failing lines are not always at the end -- a shell test writes
    them to stderr while its ok lines go to stdout -- so printing the
    tail alone can hide the one line that says what is wrong.
    """
    lines = [l for l in text.splitlines() if l.strip()]
    bad = [l for l in lines if re.match(r"\s*(FAIL|fail|failed|ERROR|E\s|not ok)\b", l)
           or "Traceback" in l or re.match(r"\s*assert", l)]
    out = ["      | " + l for l in bad[:12]]
    if out:
        out.append("      | ...")
    out += ["      | " + l for l in lines[-12:]]
    return "\n".join(out) or "      | (no output)"


def do_list(chosen):
    for s in chosen:
        extra = " ".join(x for _r, p, _a in s["plus"] for x in p)
        how = "(not run)" if "never" in s else " ".join(s["argv"]) + (
            " [" + extra + " when there is one]" if extra else "")
        print("%-32s %s" % (s["name"], s["cwd"]))
        print("    how    %s" % how)
        print("    from   %s" % s["doc"])
        if s["needs"]:
            print("    needs  %s" % ", ".join(s["needs"]))
        if s["fuller"]:
            print("    fuller %s" % ", ".join(s["fuller"]))
        if "never" in s:
            print("    skip   %s" % s["never"])
        print()
    print("%d suite(s)" % len(chosen))


def report(results, before, after, dropped, jobs, image, iso, seconds):
    by_repo = {}
    for r in results:
        by_repo.setdefault(r["repo"], []).append(r)

    print("\n" + "=" * 72)
    print("raye-tests: %d suite(s) in %d repositories, %d at a time, %.0fs"
          % (len(results), len(by_repo), jobs, seconds))
    if iso:
        print("image      %s%s" % (iso, "" if image else "  (NOT opened)"))
    print("=" * 72)
    print("%-14s %6s %6s %6s %6s   %s" % ("repo", "suites", "pass", "FAIL", "skip",
                                          "tests (pass/fail/skip)"))
    tot = [0, 0, 0, 0, 0, 0]
    for repo in sorted(by_repo):
        rs = by_repo[repo]
        p = sum(1 for r in rs if r["state"] == PASS)
        f = sum(1 for r in rs if r["state"] == FAIL)
        k = sum(1 for r in rs if r["state"] == SKIP)
        tp = sum(r["passed"] or 0 for r in rs)
        tf = sum(r["failed"] or 0 for r in rs)
        tk = sum(r["inner_skipped"] or 0 for r in rs)
        print("%-14s %6d %6d %6s %6d   %d/%d/%d"
              % (repo, len(rs), p, f or "-", k, tp, tf, tk))
        for i, v in enumerate((len(rs), p, f, k, tp, tf)):
            tot[i] += v
    print("-" * 72)
    print("%-14s %6d %6d %6s %6d" % ("TOTAL", tot[0], tot[1], tot[2] or "-", tot[3]))

    fails = [r for r in results if r["state"] == FAIL]
    if fails:
        print("\nFAILED (%d) -- each one, with the end of its output:" % len(fails))
        for r in fails:
            print("\n  %s  (%s, %ss)" % (r["name"], r["reason"], r["seconds"]))
            print("      from %s" % r["doc"])
            print(excerpt(r["output"]))

    skips = [r for r in results if r["state"] == SKIP]
    if skips:
        print("\nSKIPPED (%d) -- named, never counted as a pass:" % len(skips))
        for r in sorted(skips, key=lambda r: r["name"]):
            print("  %-32s %s" % (r["name"], r["reason"]))

    partial = [r for r in results if r["notes"]]
    if partial:
        print("\nRAN, BUT NOT AGAINST EVERYTHING IT IS ABOUT (%d):" % len(partial))
        for r in sorted(partial, key=lambda r: r["name"]):
            for n in r["notes"]:
                print("  %-32s %s" % (r["name"], n))

    inner = [r for r in results
             if r["state"] == PASS and (r["inner_skipped"] or 0) > 0]
    if inner:
        print("\nTESTS SKIPPED INSIDE A GREEN SUITE (%d) -- a green that covers less"
              "\nthan it looks like it does:" % len(inner))
        for r in sorted(inner, key=lambda r: -(r["inner_skipped"] or 0)):
            print("  %-32s %d of %d" % (r["name"], r["inner_skipped"], r["ran"]))

    def is_cache(rel):
        return "__pycache__" in rel or ".pytest_cache" in rel or rel.endswith(".pyc")

    caches = [d for d in dropped if is_cache(d[1])]
    other = [d for d in dropped if not is_cache(d[1])]
    print()
    if caches:
        print("bytecode or test caches left under the repositories (%d):" % len(caches))
        for repo, rel in caches[:10]:
            print("  %s/%s" % (repo, rel))
        if len(caches) > 10:
            print("  ... and %d more" % (len(caches) - 10))
        print("  Every suite runs with PYTHONDONTWRITEBYTECODE=1, which these escape:")
        print("  a test that re-execs python3 with -I is in ISOLATED mode, and -I")
        print("  ignores every PYTHON* variable, so the child writes bytecode")
        print("  whatever the launcher sets -- under ctest too. The fix is -I -B")
        print("  on that call. --strict fails the run on this.")
    else:
        print("bytecode or test caches left under the repositories: none")
    if other:
        print("other files changed while the run was going on (%d) -- a run writes"
              " no\nsource file, so on a shared machine this is somebody working:"
              % len(other))
        for repo, rel in other[:10]:
            print("  %s/%s" % (repo, rel))
        if len(other) > 10:
            print("  ... and %d more" % (len(other) - 10))
    else:
        print("other files changed while the run was going on: none")
    changed = [r for r in sorted(before) if before[r] != after.get(r)]
    print("git status changed during the run in: %s"
          % (", ".join(changed) if changed else "no repository"))
    return fails, skips, caches


def main():
    ap = argparse.ArgumentParser(
        prog="raye-tests", add_help=True,
        description="Run every automated test suite of /srv/raye. "
                    "Reads nothing it does not say, writes nothing in the repos.")
    ap.add_argument("command", nargs="?", default="check", choices=["check", "list"])
    ap.add_argument("--repo", action="append", default=[], metavar="NAME")
    ap.add_argument("--suite", action="append", default=[], metavar="GLOB")
    ap.add_argument("--iso", metavar="FILE", help="the image to question")
    ap.add_argument("--no-iso", action="store_true", help="repository-only verdicts")
    ap.add_argument("--release", action="store_true",
                    help="also the suites the image build alone turns on")
    ap.add_argument("--strict", action="store_true",
                    help="a skip, or bytecode left under a repository,"
                         " fails the run too")
    ap.add_argument("--jobs", type=int, default=4, metavar="N")
    ap.add_argument("--json", metavar="FILE", help="write the report there too")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="print the whole output of every suite")
    a = ap.parse_args()

    manifest = load_suites()
    chosen = manifest
    if a.repo:
        chosen = [s for s in chosen if s["repo"] in a.repo]
    if a.suite:
        chosen = [s for s in chosen
                  if any(fnmatch.fnmatch(s["name"], g) or s["name"] == g
                         for g in a.suite)]
    if not chosen:
        print("raye-tests: nothing selected. `raye-tests list` shows the names.",
              file=sys.stderr)
        return 2
    if a.command == "list":
        do_list(chosen)
        return 0

    work = tempfile.mkdtemp(prefix="raye-tests-work.")
    left_mounted = []
    iso = None if a.no_iso else (a.iso or (DEFAULT_ISO if os.path.exists(DEFAULT_ISO)
                                           else None))
    ctx = dict(work=work, iso=iso, image=None, release=a.release,
               no_iso_why="no ISO given and %s does not exist" % DEFAULT_ISO
               if not a.no_iso else "--no-iso was asked for")
    ctx["no_image_why"] = ctx["no_iso_why"]
    image = None
    wanted = any("image" in s["fuller"] or "image" in s["needs"] for s in chosen)
    started = time.monotonic()
    try:
        if iso and wanted:
            image = Image(iso, work)
            if image.open():
                ctx["image"] = image.tree
            else:
                ctx["no_image_why"] = "the ISO could not be opened: %s" % image.why
                print("raye-tests: %s" % ctx["no_image_why"], file=sys.stderr)
        repos = {s["repo"] for s in chosen}
        before = git_fingerprint(repos)
        since = time.time()
        results = []
        with ThreadPoolExecutor(max_workers=max(1, a.jobs)) as pool:
            for r in pool.map(lambda s: run_one(s, ctx), chosen):
                mark = {PASS: "ok  ", FAIL: "FAIL", SKIP: "skip"}[r["state"]]
                extra = ""
                if r["ran"]:
                    extra = "  %d test(s)" % r["ran"]
                if r["state"] != PASS:
                    extra += "  -- " + r["reason"]
                print("[%s] %-32s %5ss%s" % (mark, r["name"], r["seconds"], extra),
                      flush=True)
                if a.verbose and r["output"]:
                    print(tail(r["output"], 10000))
                results.append(r)
        after = git_fingerprint(repos)
        dropped = left_behind(repos, since)
    finally:
        if image:
            left_mounted = image.close()
        # Only when nothing is left mounted. The old line ran rmtree
        # unconditionally, so it walked INTO the live overlay and deleted
        # through it -- every write landing in upperdir as a whiteout over
        # the image. Nothing of the ISO can be lost that way, and that is
        # luck, not design: the same call against a read-write mount of
        # something real would have emptied it.
        if left_mounted:
            print("raye-tests: %s is kept: %d mount(s) still there."
                  % (work, len(left_mounted)), file=sys.stderr)
            for at in reversed(left_mounted):
                print("raye-tests:   umount %s" % at, file=sys.stderr)
            print("raye-tests:   rm -rf %s" % work, file=sys.stderr)
        else:
            shutil.rmtree(work, ignore_errors=True)

    results.sort(key=lambda r: r["name"])
    fails, skips, caches = report(results, before, after, dropped, a.jobs, ctx["image"],
                          iso, time.monotonic() - started)
    if a.json:
        with open(a.json, "w") as fh:
            json.dump([{k: v for k, v in r.items() if k != "output"}
                       for r in results], fh, indent=1)
    if fails:
        return 1
    if a.strict and skips:
        print("\n--strict: %d skipped suite(s), so this run does not pass."
              % len(skips))
        return 1
    # A cache dropped under a repository is attributable: the run computes it
    # by comparing the tree before and after, so it was a suite that wrote it.
    # Reporting it and passing anyway is how it survived -- the report named
    # the file for weeks while every run went green.
    if a.strict and caches:
        print("\n--strict: %d bytecode/cache file(s) left under the"
              " repositories, so this run does not pass." % len(caches))
        return 1
    if a.strict and left_mounted:
        print("\n--strict: %d mount(s) left behind, so this run does not pass."
              % len(left_mounted))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
