# Which binary package ships each file of release/ (and the keyring), and
# where it goes.
#
#   package   source   destination   [options]
#
# The source is relative to the top of raye-base: a file (the destination
# is its full path), a folder (the destination is a folder and the tree
# under it is kept) or a glob with * or [..] (the matching files go under
# the destination folder, with their path below the glob's fixed part).
# "?" in front of the source: the part that brings it is not written yet,
# so the build skips it while it is missing (RAYE_PATHS_STRICT=1 makes
# that an error).
#
# Options:
#   divert     the destination belongs to another package: it is moved
#              aside to <path>.ubuntu while ours is installed (one file only)
#   no-start   a system unit that is enabled but never started or
#              restarted when the package is installed or upgraded
#
# The first line that covers a file ships it, so a precise line goes
# before a glob or folder line of the same folder. Every file under
# release/ must be shipped by a line, or the build stops; tests/ folders,
# README* and *.md files are never shipped. debian/raye_release.py reads
# this file.

# ---------------------------------------------------------------- keyring
raye-archive-keyring  keyring/raye-archive-keyring.gpg  usr/share/keyrings/raye-archive-keyring.gpg
raye-archive-keyring  release/apt/raye.sources          etc/apt/sources.list.d/raye.sources
raye-archive-keyring  release/apt/raye-mirrors.list     etc/apt/mirrors/raye.list

# ---------------------------------------------------------------- release
# os-release and friends; raye-release.links puts them in place.
raye-release  release/os-release   usr/lib/raye/os-release
raye-release  release/lsb-release  usr/lib/raye/lsb-release
raye-release  release/issue        usr/lib/raye/issue
raye-release  release/issue.net    usr/lib/raye/issue.net
raye-release  release/dpkg/raye    etc/dpkg/origins/raye
raye-release  release/apt/mozilla.sources              etc/apt/sources.list.d/mozilla.sources
raye-release  release/apt/raye-pins.pref               etc/apt/preferences.d/raye-pins.pref
raye-release  release/apt/mozilla-archive-keyring.asc  usr/share/keyrings/mozilla-archive-keyring.asc
# What python-apt knows about this system's sources. Without it,
# add-apt-repository, software-properties and Synaptic's repository
# dialog stop on NoDistroTemplateException before doing anything; in a
# package, so an upgrade of python-apt cannot take it away.
raye-release  release/python-apt/raye.info     usr/share/python-apt/templates/raye.info
raye-release  release/python-apt/raye.mirrors  usr/share/python-apt/templates/raye.mirrors
# GP-43: one Raye line instead of the help lines at a terminal sign-in.
# Each file takes the place of the base system's script of the same name:
# raye-release.links puts it there. Shipped in /etc it was a conffile over
# base-files' own, and dpkg asked about it at configure.
raye-release  release/identity/motd/*  usr/lib/raye/motd

