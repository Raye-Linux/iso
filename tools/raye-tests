# running

def run_one(s, ctx):
    repo = os.path.join(RAYE, s["cwd"])
    sub = dict(ctx)
    sub["repo"] = os.path.join(RAYE, s["repo"])
    res = dict(name=s["name"], repo=s["repo"], doc=s["doc"], seconds=0.0,
               ran=None, passed=None, failed=None, inner_skipped=None,
               notes=[], output="", code=None)

    if "never" in s:
        res.update(state=SKIP, reason=s["never"])
        return res
    if s["gate"] == "release" and not ctx["release"]:
        res.update(state=SKIP,
                   reason="release gate only (RAYE_RELEASE); run with --release")
        return res
    if not os.path.isdir(repo):
        res.update(state=SKIP, reason="%s is not checked out" % s["cwd"])
        return res
    for req in s["needs"]:
        why = missing(req, sub)
        if why:
            res.update(state=SKIP, reason=why)
            return res
    for req in s["fuller"]:
        why = missing(req, sub)
        if why:
            res["notes"].append("partial verdict: " + why)

    work = tempfile.mkdtemp(prefix="raye-tests.", dir=ctx["work"])
    sub["work"] = work
    env = dict(os.environ)
    env.update(PYTHONDONTWRITEBYTECODE="1", LC_ALL="C.UTF-8", LANGUAGE="en",
               QT_QPA_PLATFORM="offscreen", PYTHONPYCACHEPREFIX=work)
    for k, v in s["env"].items():
        env[k] = v.format(**sub)
    if ctx.get("image"):
        env["RAYE_ROOT"] = ctx["image"]

    argv = list(s["argv"])
    for req, present, absent in s["plus"]:
        argv += present if missing(req, sub) is None else absent
    argv = [a.format(**sub) for a in argv]
    start = time.monotonic()
    try:
        p = subprocess.run(argv, cwd=repo, env=env, capture_output=True, text=True,
                           timeout=s["timeout"], stdin=subprocess.DEVNULL)
        out, code = p.stdout + p.stderr, p.returncode
    except subprocess.TimeoutExpired as e:
        out = (e.stdout or "") + (e.stderr or "") if isinstance(e.stdout, str) else ""
        code = None
    except OSError as e:
        out, code = str(e), -1
    res["seconds"] = round(time.monotonic() - start, 1)
    res["output"], res["code"] = out, code
    shutil.rmtree(work, ignore_errors=True)

    if code is None:
        res.update(state=FAIL, reason="timed out after %ds" % s["timeout"])
        return res
    if code == SKIP_CODE:
        last = [l for l in out.splitlines() if l.strip()]
        res.update(state=SKIP,
                   reason="the test skipped itself (77): " + (last[-1] if last else "?"))
        return res

    for pat, note in s["notes_on"]:
        if pat in out:
            res["notes"].append(note)
    c = counts(s["count"], out) if s["count"] else None
    if c:
        res.update(ran=c[0], passed=c[1], failed=c[2], inner_skipped=c[3])

    if code != 0:
        res.update(state=FAIL, reason="exit %d" % code)
        return res
    # pytest exits 5 on "no tests collected"; unittest exits 0 on "Ran 0 tests".
    # Both are a green that proves nothing, so neither is allowed to pass.
    if s["count"]:
        if c is None:
            res.update(state=FAIL,
                       reason="nothing could be counted in the output: the suite "
                              "may not have run at all")
            return res
        if c[0] == 0:
            res.update(state=FAIL, reason="no test ran")
            return res
    res.update(state=PASS, reason="")
    return res


SKIP_DIRS = {".git"}


def left_behind(repos, since):
    """Files under the repositories that appeared or changed during a run.

    `git status` is not enough on its own: __pycache__ is in theme's
    .gitignore (line 11), so bytecode dropped there is invisible to it.
    A guard that cannot see the one thing that goes wrong is not a guard.

    No attempt is made to say WHO wrote each file. On this machine both
    the launcher and the person working run as root, so ownership proves
    nothing; claiming it would be a guess dressed as a measurement. What
    the report does instead is separate the two kinds: bytecode and test
    caches, which a test run can drop, from everything else, which a
    test run never writes.
    """
    found = []
    for r in sorted(repos):
        top = os.path.join(RAYE, r)
        for root, dirs, names in os.walk(top):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            for n in names:
                f = os.path.join(root, n)
                try:
                    st = os.lstat(f)
                except OSError:
                    continue
                if st.st_mtime >= since:
                    found.append((r, os.path.relpath(f, top)))
    return found


def git_fingerprint(repos):
    """What `git status --porcelain` says in each repo, hashed."""
    out = {}
    env = dict(os.environ, HOME="/root")
    for r in sorted(repos):
        p = os.path.join(RAYE, r)
        if not os.path.isdir(os.path.join(p, ".git")):
            out[r] = "no .git"
            continue
        subprocess.run(["git", "config", "--global", "--add", "safe.directory", p],
                       env=env, capture_output=True)
        st = subprocess.run(["git", "status", "--porcelain"], cwd=p, env=env,
                            capture_output=True, text=True)
        out[r] = hashlib.md5(st.stdout.encode()).hexdigest()
    return out


