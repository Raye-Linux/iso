# Your phone: ports for pairing when the firewall is on (GP-42).
raye-desktop  ?release/phone/raye-phone  etc/ufw/applications.d/raye-phone
# Finding PCs and NAS on the network: the replies they send back.
raye-desktop  release/network/raye-network-discovery  etc/ufw/applications.d/raye-network-discovery

# Start entries of stock apps: hidden from Start, or under a plain name.
# The apps stay installed and run the same command.
raye-desktop  release/identity/apps/*.desktop  usr/share/applications  divert

# Account settings an older Raye wrote, moved once at sign-in.
raye-desktop  release/kconf_update  usr/share/kconf_update

# A new account's first desktop and folders (GP-45).
raye-desktop  release/skel                    etc/skel
