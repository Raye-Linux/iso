#!/bin/sh
# Installs the driver this computer needs that the base system does not
# carry, NVIDIA graphics above all.
#
# Only drivers that come with kernel modules already signed for Secure
# Boot: those keep working without any key enrolment screen. A driver
# that would have to be built on the machine (DKMS) is left alone and
# reported, it needs the key enrolment flow that comes later. Ubuntu's
# OEM enablement packages are never pulled in.
#
# Exit 75 means "try again later" (no network yet).
#
# It looks once, and again when the graphics cards of the PC change (a new
# card, a card moved to another PC): the cards it saw are kept in
# drivers-hardware. A driver already installed for an NVIDIA card (picked
# in Settings, say) is kept as it is.
#
#   raye-drivers           look, install
#   raye-drivers --again   look even if done once already (Raye Settings)
#   raye-drivers --needed  exit 0 when there is something to do at this
#                          start (raye-drivers.service's ExecCondition)

set -u
state=${RAYE_DRIVERS_STATE:-/var/lib/raye}
sys=${RAYE_SYS:-/sys}
done_file=$state/drivers-done
hardware_file=$state/drivers-hardware
# set by raye-system's postinst on a PC that has the NVIDIA driver and no
# NVIDIA Control Panel (installed before the panel was asked for)
panel_file=$state/drivers-nvidia-panel
# Ubuntu's signed NVIDIA modules are built for Ubuntu's kernel and never
# load on the Raye kernel: there the driver comes with the modules Raye
# built and signed for it (linux-modules-nvidia-<branch>-raye, which also
# stands in for NVIDIA's DKMS package). Until Raye has them for the driver
# this PC needs, nothing is installed and the next start looks again.
release=${RAYE_UNAME_R:-$(uname -r)}
on_raye_kernel() { case $release in *-raye) return 0 ;; esac; return 1; }

# the graphics cards of this PC, "vendor:device" one per line, sorted
cards() {
    for dev in "$sys"/bus/pci/devices/*; do
        [ -r "$dev/class" ] || continue
        read -r class < "$dev/class" || continue
        case $class in 0x03*) ;; *) continue ;; esac
        read -r vendor < "$dev/vendor" 2>/dev/null || continue
        read -r device < "$dev/device" 2>/dev/null || continue
        echo "$vendor:$device"
    done | sort -u
}

record_cards() { mkdir -p "$state" && cards > "$hardware_file"; }

cards_changed() {
    [ -e "$hardware_file" ] || return 1
    [ "$(cards)" != "$(cat "$hardware_file")" ]
}

nvidia_driver_installed() {
    dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'nvidia-driver-*' 2>/dev/null | grep -q '^ii  *nvidia-driver-'
}

if [ "${1:-}" = --needed ]; then
    [ -e "$done_file" ] || exit 0
    [ -e "$panel_file" ] && exit 0
    # done before the cards were kept (Raye 1.0 Beta and older): keep them now
    if [ ! -e "$hardware_file" ]; then
        record_cards
        exit 1
    fi
    cards_changed && exit 0
    exit 1
fi

# the NVIDIA Control Panel only, once
if [ -e "$panel_file" ] && [ "${1:-}" != --again ]; then
    getent hosts archive.ubuntu.com >/dev/null 2>&1 || exit 75
    apt-get update -q || exit 75
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends nvidia-settings || exit 1
    rm -f "$panel_file"
    exit 0
fi

changed=
cards_changed && changed=yes
# --again: asked for from Raye Settings, look even if done once already
[ "${1:-}" = --again ] || [ -n "$changed" ] || { [ -e "$done_file" ] && exit 0; }
command -v ubuntu-drivers >/dev/null || exit 0

finish() { mkdir -p "$state"; echo "$1" > "$done_file"; record_cards; exit 0; }

# new cards on a PC that already has an NVIDIA driver: it stays, whichever
# one it is (Settings > Raye Update > Drivers changes it)
if [ -n "$changed" ] && [ "${1:-}" != --again ] && nvidia_driver_installed; then
    finish "kept the installed NVIDIA driver"
fi

getent hosts archive.ubuntu.com >/dev/null 2>&1 || exit 75

recommended=$(ubuntu-drivers devices 2>/dev/null |
    sed -n 's/^driver *: \([^ ]*\) .*recommended.*/\1/p' |
    grep -E '^(nvidia-driver-[0-9]+(-open)?|bcmwl-kernel-source)$' | head -n 1)
[ -n "$recommended" ] || finish "nothing to install"

if on_raye_kernel; then
    case $recommended in
    nvidia-driver-*) ;;
    *)  echo "raye-drivers: $recommended would be built on this PC (DKMS), not installing it" >&2
        finish "skipped $recommended (DKMS)" ;;
    esac
    apt-get update -q || exit 75
    modules=linux-modules-nvidia-${recommended#nvidia-driver-}-raye
    if ! apt-cache show "$modules" >/dev/null 2>&1; then
        # not done: the next start looks again
        echo "raye-drivers: no Raye kernel modules for $recommended yet" >&2
        exit 0
    fi
    DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$recommended" "$modules" nvidia-settings || exit 1
    finish "installed $recommended $modules"
fi

# "nvidia-driver-580, (kernel modules provided by linux-modules-nvidia-580-generic-hwe-26.04)"
modules=$(ubuntu-drivers list 2>/dev/null |
    sed -n "s/^$recommended, (kernel modules provided by \(.*\))\$/\1/p" | head -n 1)
if [ -z "$modules" ]; then
    echo "raye-drivers: $recommended has no signed modules, not installing it" >&2
    finish "skipped $recommended (unsigned)"
fi

# nvidia-settings is only a Recommends of the driver; it is the NVIDIA
# Control Panel in Start
panel=
case $recommended in nvidia-driver-*) panel=nvidia-settings ;; esac

apt-get update -q || exit 75
# shellcheck disable=SC2086  # empty when there is no panel to add
DEBIAN_FRONTEND=noninteractive apt-get install -y -q "$recommended" "$modules" $panel || exit 1
finish "installed $recommended $modules"
