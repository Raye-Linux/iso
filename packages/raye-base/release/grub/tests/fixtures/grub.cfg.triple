### BEGIN /etc/grub.d/00_header ###
if [ -s $prefix/grubenv ]; then
  set have_grubenv=true
  load_env
fi
set default="0"
### END /etc/grub.d/00_header ###

### BEGIN /etc/grub.d/10_linux ###
function gfxmode {
	set gfxpayload="${1}"
}
set linux_gfx_mode=
export linux_gfx_mode
menuentry 'Raye Linux' --class raye --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-simple-0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f' {
	recordfail
	load_video
	gfxmode $linux_gfx_mode
	insmod gzio
	insmod part_gpt
	insmod btrfs
	search --no-floppy --fs-uuid --set=root 0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f
	linux	/@/boot/vmlinuz-7.0.0-9-generic root=UUID=0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f ro rootflags=subvol=@ quiet splash panic=30
	initrd	/@/boot/initrd.img-7.0.0-9-generic
}
submenu 'Advanced options for Raye Linux' $menuentry_id_option 'gnulinux-advanced-0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f' {
	menuentry 'Raye Linux, with Linux 7.0.0-9-generic' --class raye --class gnu-linux --class gnu --class os $menuentry_id_option 'gnulinux-7.0.0-9-generic-advanced-0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f' {
		recordfail
		linux	/@/boot/vmlinuz-7.0.0-9-generic root=UUID=0c1d2e3f-4a5b-6c7d-8e9f-0a1b2c3d4e5f ro rootflags=subvol=@ quiet splash panic=30
		initrd	/@/boot/initrd.img-7.0.0-9-generic
	}
}
### END /etc/grub.d/10_linux ###

### BEGIN /etc/grub.d/30_os-prober ###
set timeout_style=menu
if [ "${timeout}" = 0 ]; then
  set timeout=10
fi
menuentry 'Windows Boot Manager (on /dev/nvme0n1p1)' --class windows --class os $menuentry_id_option 'osprober-efi-A1B2-C3D4' {
	insmod part_gpt
	insmod fat
	search --no-floppy --fs-uuid --set=root A1B2-C3D4
	chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
menuentry 'Fedora Linux 42 (Workstation Edition) (on /dev/nvme0n1p6)' --class fedora --class gnu-linux --class gnu --class os $menuentry_id_option 'osprober-gnulinux-simple-aaaa1111-bbbb-2222-cccc-333344445555' {
	insmod part_gpt
	insmod ext2
	search --no-floppy --fs-uuid --set=root aaaa1111-bbbb-2222-cccc-333344445555
	linux /vmlinuz-6.14.0-63.fc42.x86_64 root=UUID=aaaa1111-bbbb-2222-cccc-333344445555 ro
	initrd /initramfs-6.14.0-63.fc42.x86_64.img
}
submenu 'Advanced options for Fedora Linux 42 (Workstation Edition) (on /dev/nvme0n1p6)' $menuentry_id_option 'osprober-gnulinux-advanced-aaaa1111-bbbb-2222-cccc-333344445555' {
	menuentry 'Fedora Linux 42 (Workstation Edition) (on /dev/nvme0n1p6), with Linux 6.14.0-63.fc42.x86_64' --class gnu-linux --class gnu --class os $menuentry_id_option 'osprober-gnulinux-6.14.0-63.fc42.x86_64--aaaa1111-bbbb-2222-cccc-333344445555' {
		linux /vmlinuz-6.14.0-63.fc42.x86_64 root=UUID=aaaa1111-bbbb-2222-cccc-333344445555 ro
		initrd /initramfs-6.14.0-63.fc42.x86_64.img
	}
}
### END /etc/grub.d/30_os-prober ###

