def is_root():
    return os.geteuid() == 0


def say(text, quiet):
    if not quiet:
        print(text, file=sys.stderr, flush=True)


def child_env():
    return {"PATH": SYSTEM_PATH, "LC_ALL": "C.UTF-8"}


def run(argv):
    """Runs a system command with a clean environment. Returns
    (exit code, output); a missing command is exit code 127."""
    exe = shutil.which(argv[0], path=SYSTEM_PATH)
    if exe is None:
        return 127, "%s: not found\n" % argv[0]
    p = subprocess.run([exe] + argv[1:], stdin=subprocess.DEVNULL, env=child_env(),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, errors="replace")
    return p.returncode, p.stdout


# ---------------------------------------------------------------- PE files

def pe_version(path):
    """The product version in a program's version resource ("14.51.36247.0"),
    or None when the file is not a Windows program or has none."""
    try:
        with open(path, "rb") as f:
            data = f.read(MAX_DOWNLOAD)
        return _pe_version(data)
    except (OSError, struct.error, IndexError, ValueError):
        return None


def _pe_version(data):
    if data[:2] != b"MZ":
        return None
    pe = struct.unpack_from("<I", data, 0x3C)[0]
    if data[pe:pe + 4] != b"PE\0\0":
        return None
    sections, = struct.unpack_from("<H", data, pe + 6)
    opt_size, = struct.unpack_from("<H", data, pe + 20)
    opt = pe + 24
    magic, = struct.unpack_from("<H", data, opt)
    if magic not in (0x10B, 0x20B):
        return None
    dirs = opt + (96 if magic == 0x10B else 112)
    rsrc_rva, _ = struct.unpack_from("<II", data, dirs + 2 * 8)
    if not rsrc_rva:
        return None
    table = opt + opt_size

    def offset(rva):
        for i in range(min(sections, 96)):
            s = table + 40 * i
            vsize, vaddr, rsize, raddr = struct.unpack_from("<IIII", data, s + 8)
            if vaddr <= rva < vaddr + max(vsize, rsize):
                return raddr + rva - vaddr
        raise ValueError("address outside the file")

    base = offset(rsrc_rva)

    def entries(at):
        named, ids = struct.unpack_from("<HH", data, base + at + 12)
        return [struct.unpack_from("<II", data, base + at + 16 + 8 * i)
                for i in range(min(named + ids, 256))]

    # type -> name -> language: three directory levels, then the data
    level = [target for key, target in entries(0) if key == 16]   # RT_VERSION
    for _ in range(2):
        if not level or not level[0] & 0x80000000:
            return None
        level = [target for _, target in entries(level[0] & 0x7FFFFFFF)]
    if not level or level[0] & 0x80000000:
        return None
    rva, size = struct.unpack_from("<II", data, base + level[0])
    start = offset(rva)
    blob = data[start:start + size]
    i = blob.find(b"\xbd\x04\xef\xfe")      # VS_FIXEDFILEINFO
    if i < 0:
        return None
    ms, ls = struct.unpack_from("<II", blob, i + 16)
    return "%d.%d.%d.%d" % (ms >> 16, ms & 0xFFFF, ls >> 16, ls & 0xFFFF)


# ---------------------------------------------------------------- state

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def read_saved():
    try:
        with open(os.path.join(STATE_DIR, "components.json")) as f:
            saved = json.load(f)
        return saved if isinstance(saved, dict) else {}
    except (OSError, ValueError):
        return {}


def good_redist(saved):
    """The runtime files that are there and still the ones that passed
    the check: {arch: {name, sha256, version}}."""
    files = saved.get("files")
    good = {}
    if not isinstance(files, dict):
        return good
    for arch in REDIST:
        info = files.get(arch)
        if not isinstance(info, dict) or info.get("name") != redist_name(arch):
            continue
        try:
            if sha256_file(os.path.join(STATE_DIR, info["name"])) == info.get("sha256"):
                good[arch] = info
        except OSError:
            pass
    return good


def redist_name(arch):
    return "vc_redist.%s.exe" % arch


def older_name(key):
    return "vcredist-%s.exe" % key


def good_older(saved):
    """The older runtimes that are there and still their pinned file:
    {key: {name, sha256}}."""
    files = saved.get("older")
    good = {}
    if not isinstance(files, dict):
        return good
    for key, _, pin in OLDER:
        info = files.get(key)
        if not isinstance(info, dict) or info.get("name") != older_name(key) or info.get("sha256") != pin:
            continue
        try:
            if sha256_file(os.path.join(STATE_DIR, info["name"])) == pin:
                good[key] = info
        except OSError:
            pass
    return good


def fonts_present():
    for name, _, _, _ in FONTS:
        try:
            if not stat.S_ISREG(os.lstat(os.path.join(FONT_DIR, name)).st_mode):
                return False
        except OSError:
            return False
    return True


def current():
    saved = read_saved()
    good = good_redist(saved)
    older = good_older(saved)
    vcredist = good["x64"]["version"] if len(good) == len(REDIST) and len(older) == len(OLDER) else None
    state = {"fonts": fonts_present(), "vcredist": vcredist, "older": sorted(older)}
    state["missing"] = [n for n in NAMES if not state[n]]
    return state


def save(fonts, files, older=None):
    """components.json, written whole or not at all."""
    if older is None:
        older = good_older(read_saved())
    vcredist = files["x64"]["version"] if len(files) == len(REDIST) and len(older) == len(OLDER) else None
    state = {"fonts": fonts, "vcredist": vcredist, "files": files, "older": older}
    # a run that changed nothing leaves the file alone: each user's
    # raye-windows-prepare.path rebuilds the ready space when it moves
    saved = read_saved()
    saved.pop("updated", None)
    if saved == json.loads(json.dumps(state)):
        return
    state["updated"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    text = json.dumps(state, indent=2, sort_keys=True) + "\n"
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".components.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(STATE_DIR, "components.json"))
    except BaseException:
        os.unlink(tmp)
        raise


def open_state_dir():
    """Makes the folder (root's, 0755, never a link) and takes its lock.
    Returns the lock's file descriptor."""
    parent = os.path.dirname(STATE_DIR)
    os.makedirs(parent, 0o755, exist_ok=True)
    try:
        os.mkdir(STATE_DIR, 0o755)
    except FileExistsError:
        pass
    st = os.lstat(STATE_DIR)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        raise OSError("%s is not a folder of ours" % STATE_DIR)
    os.chmod(STATE_DIR, 0o755)
    fd = os.open(os.path.join(STATE_DIR, ".lock"),
                 os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


# ---------------------------------------------------------------- fonts

def install_fonts(quiet):
    """All the fonts or none: each cabinet and each font is checked
    before the first one is put in place."""
    if fonts_present():
        return True
    say("Downloading the fonts...", quiet)
    work = tempfile.mkdtemp(dir=STATE_DIR, prefix=".fonts-")
    try:
        for cab, sha in FONT_CABS:
            dest = os.path.join(work, cab)
            for url in FONT_URLS:
                if download(url % cab, dest, MAX_DOWNLOAD):
                    if sha256_file(dest) == sha:
                        break
                    os.unlink(dest)
            else:
                print("%s could not be downloaded" % cab, file=sys.stderr)
                return False
            out = os.path.join(work, cab + ".d")
            os.mkdir(out)
            code, text = run(["cabextract", "-q", "-L", "-d", out, dest])
            if code != 0:
                print(text, end="", file=sys.stderr)
                return False
        for name, cab, short, sha in FONTS:
            path = os.path.join(work, cab + ".d", short)
            if not os.path.isfile(path) or os.path.islink(path) or sha256_file(path) != sha:
                print("%s is not the expected font" % short, file=sys.stderr)
                return False
        say("Adding the fonts...", quiet)
        os.makedirs(FONT_DIR, 0o755, exist_ok=True)
        for name, cab, short, _ in FONTS:
            place(os.path.join(work, cab + ".d", short), name)
            link = os.path.join(FONT_DIR, short)
            tmp = os.path.join(FONT_DIR, ".%s.new" % short)
            if os.path.lexists(tmp):
                os.unlink(tmp)
            os.symlink(name, tmp)
            os.replace(tmp, link)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    run(["fc-cache", FONT_DIR])
    return fonts_present()


def place(src, name):
    """Copies a checked file into the fonts folder under its name."""
    tmp = os.path.join(FONT_DIR, ".%s.new" % name)
    if os.path.lexists(tmp):
        os.unlink(tmp)
    try:
        with open(src, "rb") as f, open(tmp, "xb") as g:
            shutil.copyfileobj(f, g)
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(FONT_DIR, name))
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def remove_fonts(quiet):
    say("Removing the fonts...", quiet)
    for name, _, short, _ in FONTS:
        link = os.path.join(FONT_DIR, short)
        if os.path.islink(link) and os.readlink(link) == name:
            os.unlink(link)
        try:
            os.unlink(os.path.join(FONT_DIR, name))
        except FileNotFoundError:
            pass
    try:
        os.rmdir(FONT_DIR)
    except OSError:
        pass                    # not there, or holds something else
    run(["fc-cache", os.path.dirname(FONT_DIR)])
    return not fonts_present()


# ---------------------------------------------------------------- runtime

def read_signers(path):
    """redist-signers.txt: {"code"|"time": {sha256: [url, ...]}}."""
    pins = {"code": {}, "time": {}}
    with open(path) as f:
        for number, line in enumerate(f, 1):
            line = line.split("#", 1)[0].split()
            if not line:
                continue
            if (len(line) != 3 or line[0] not in pins
                    or not re.fullmatch(r"[0-9A-Fa-f]{64}", line[1])
                    or not re.match(r"https?://", line[2])):
                raise ValueError("%s:%d: not a signer line" % (path, number))
            pins[line[0]].setdefault(line[1].lower(), []).append(line[2])
    if not all(pins.values()):
        raise ValueError("%s: needs code and time lines" % path)
    return pins


def download(url, dest, limit):
    """Fetches url into the new file dest; False when it cannot."""
    try:
        with urllib.request.urlopen(url, timeout=TIMEOUT) as r, \
                open(dest, "xb") as f:
            got = 0
            for chunk in iter(lambda: r.read(1 << 20), b""):
                got += len(chunk)
                if got > limit:
                    raise ValueError("too big")
                f.write(chunk)
        return True
    except (OSError, ValueError, urllib.error.URLError):
        try:
            os.unlink(dest)
        except FileNotFoundError:
            pass
        return False


def pem(der):
    text = base64.b64encode(der).decode()
    lines = [text[i:i + 64] for i in range(0, len(text), 64)]
    return "-----BEGIN CERTIFICATE-----\n%s\n-----END CERTIFICATE-----\n" % "\n".join(lines)


def fetch_roots(pins, work):
    """The pinned root certificates, fetched and checked, as PEM files:
    {"code": path, "time": path}, or None when any kind has none."""
    files = {}
    for kind, roots in pins.items():
        text = ""
        for sha, urls in roots.items():
            for i, url in enumerate(urls):
                dest = os.path.join(work, "%s-%s-%d.der" % (kind, sha[:16], i))
                if not download(url, dest, MAX_CERT):
                    continue
                with open(dest, "rb") as f:
                    der = f.read()
                if hashlib.sha256(der).hexdigest() == sha:
                    text += pem(der)
                    break
        if not text:
            return None
        files[kind] = os.path.join(work, kind + ".pem")
        with open(files[kind], "w") as f:
            f.write(text)
    return files


def signed_by_microsoft(path, arch, roots):
    """True when osslsigncode accepts the file's signature up to a pinned
    root, Microsoft signed it, and it says it is this runtime."""
    code, out = run(["osslsigncode", "verify", "-CAfile", roots["code"],
                     "-TSA-CAfile", roots["time"], "-in", path])
    if code != 0 or not re.search(r"^Signature verification: ok$", out, re.M):
        return False
    subject = re.search(r"^\s*Subject: (.*)$", out, re.M)     # the signer's own
    if not subject:
        return False
    fields = re.findall(r"(?:^|[,/])\s*(CN|O)=([^,/]*)", subject.group(1))
    if ("CN", "Microsoft Corporation") not in fields or ("O", "Microsoft Corporation") not in fields:
        return False
    desc = re.search(r"^\s*Text description: (.*)$", out, re.M)
    pattern = r"Visual C\+\+ .*Redistributable.*\(%s\)" % re.escape(arch)
    return bool(desc and re.search(pattern, desc.group(1)))


def install_redist(quiet):
    """Returns (all there, {arch: info} of the files in place)."""
    have = good_redist(read_saved())
    need = [arch for arch in REDIST if arch not in have]
    if not need:
        return True, have
    try:
        pins = read_signers(SIGNERS)
    except (OSError, ValueError) as e:
        print(e, file=sys.stderr)
        return False, have
    work = tempfile.mkdtemp(dir=STATE_DIR, prefix=".fetch-")
    try:
        say("Checking Microsoft's certificates...", quiet)
        roots = fetch_roots(pins, work)
        if roots is None:
            print("Microsoft's certificates could not be fetched", file=sys.stderr)
            return False, have
        for arch in need:
            say("Downloading the Visual C++ runtime (%s)..." % arch, quiet)
            dest = os.path.join(work, redist_name(arch))
            for url in REDIST[arch]:
                if not download(url, dest, MAX_DOWNLOAD):
                    continue
                version = pe_version(dest)
                if version and signed_by_microsoft(dest, arch, roots):
                    os.chmod(dest, 0o644)
                    info = {"name": redist_name(arch), "sha256": sha256_file(dest),
                            "version": version, "url": url}
                    os.replace(dest, os.path.join(STATE_DIR, info["name"]))
                    have[arch] = info
                    break
                print("%s did not pass the signature check" % url, file=sys.stderr)
                os.unlink(dest)
            else:
                print("no usable Visual C++ runtime (%s)" % arch, file=sys.stderr)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return len(have) == len(REDIST), have


def install_older(quiet):
    """Returns (all there, {key: info} of the older runtimes in place)."""
    have = good_older(read_saved())
    need = [(key, url, pin) for key, url, pin in OLDER if key not in have]
    if not need:
        return True, have
    work = tempfile.mkdtemp(dir=STATE_DIR, prefix=".fetch-")
    try:
        for key, url, pin in need:
            say("Downloading the Visual C++ %s runtime..." % key, quiet)
            dest = os.path.join(work, older_name(key))
            if not download(url, dest, MAX_DOWNLOAD):
                print("%s could not be downloaded" % url, file=sys.stderr)
                continue
            if sha256_file(dest) != pin:
                print("%s is not the file Raye knows" % url, file=sys.stderr)
                os.unlink(dest)
                continue
            os.chmod(dest, 0o644)
            os.replace(dest, os.path.join(STATE_DIR, older_name(key)))
            have[key] = {"name": older_name(key), "sha256": pin}
    finally:
        shutil.rmtree(work, ignore_errors=True)
    return len(have) == len(OLDER), have


def remove_redist(quiet):
    say("Removing the Visual C++ runtime...", quiet)
    names = [redist_name(arch) for arch in REDIST] + [older_name(key) for key, _, _ in OLDER]
    for name in names:
        try:
            os.unlink(os.path.join(STATE_DIR, name))
        except FileNotFoundError:
            pass
    return True


# ---------------------------------------------------------------- main

def usage():
    print("usage: raye-windows-components status\n"
          "       raye-windows-components install [--quiet] [fonts|vcredist ...]\n"
          "       raye-windows-components remove [--quiet] fonts|vcredist ...",
          file=sys.stderr)
    return 2


def main(argv):
    quiet = "--quiet" in argv
    args = [a for a in argv if a != "--quiet"]
    if not args or args[0] not in ("status", "install", "remove"):
        return usage()
    command, names = args[0], args[1:]
    if (any(n not in NAMES for n in names) or (command == "status" and names)
            or (command == "remove" and not names)):
        return usage()
    if command == "status":
        print(json.dumps(current()))
        return 0
    if not is_root():
        print("raye-windows-components: %s needs root access" % command,
              file=sys.stderr)
        return 4
    names = [n for n in NAMES if n in names] or list(NAMES)
    # what it adds is for every account, whatever umask pkexec gave it
    os.umask(0o022)
    try:
        lock = open_state_dir()
    except OSError as e:
        print("raye-windows-components: %s" % e, file=sys.stderr)
        return 0 if quiet else 1
    try:
        files = good_redist(read_saved())
        older = good_older(read_saved())
        ok = True
        for name in names:
            # a full disk or a broken folder stops this component only
            try:
                if command == "install" and name == "fonts":
                    ok = install_fonts(quiet) and ok
                elif command == "install":
                    done, files = install_redist(quiet)
                    ok = done and ok
                    done, older = install_older(quiet)
                    ok = done and ok
                elif name == "fonts":
                    ok = remove_fonts(quiet) and ok
                else:
                    ok = remove_redist(quiet) and ok
                    files, older = {}, {}
            except OSError as e:
                print("raye-windows-components: %s: %s" % (name, e), file=sys.stderr)
                ok = False
                if name == "vcredist":
                    files = good_redist(read_saved())
                    older = good_older(read_saved())
        try:
            save(fonts_present(), files, older)
        except OSError as e:
            print("raye-windows-components: %s" % e, file=sys.stderr)
            ok = False
    finally:
        os.close(lock)
    if not quiet:
        print(json.dumps(current()))
    return 0 if ok or quiet else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
